{
  "id": "core-situation-home",
  "group": "core",
  "title": "Durum 2: ev kiralama ve arıza",
  "level": "B1",
  "intro": "<p><b>British ev terimleri:</b> emlakçı = <b>estate agent</b> (kiralık için <b>letting agent</b>), kira sözleşmesi = <b>tenancy agreement</b>, belediye vergisi = <b>council tax</b>, kombi = <b>boiler</b>, rutubet = <b>damp</b>, küf = <b>mould</b>. İngiliz evlerinde rutubet ve kombi arızası çok yaygın şikâyetlerdir!</p>",
  "words": [
    { "en": "estate agent", "tr": "emlakçı", "read": "i-[steyt] ey-cınt", "type": "isim", "level": "B1", "example": "The estate agent showed us three flats.", "exampleTr": "Emlakçı bize üç daire gösterdi.", "note": "British; Amerikan: real estate agent" },
    { "en": "letting agent", "tr": "kiralama emlakçısı", "read": "[le]-ting ey-cınt", "type": "isim", "level": "B2", "example": "Call the letting agent about the repair.", "exampleTr": "Tamir için kiralama emlakçısını ara.", "note": "British" },
    { "en": "tenant", "tr": "kiracı", "read": "[te]-nınt", "type": "isim", "level": "B1", "example": "The tenants pay the bills.", "exampleTr": "Faturaları kiracılar ödüyor.", "opposite": "landlord" },
    { "en": "tenancy agreement", "tr": "kira sözleşmesi", "read": "[te]-nın-si ı-grii-mınt", "type": "isim", "level": "B2", "example": "Read the tenancy agreement carefully.", "exampleTr": "Kira sözleşmesini dikkatle oku.", "note": "British" },
    { "en": "furnished", "tr": "eşyalı", "read": "[föö]-nişt", "type": "sıfat", "level": "B1", "example": "Is the flat furnished?", "exampleTr": "Daire eşyalı mı?", "opposite": "unfurnished" },
    { "en": "unfurnished", "tr": "eşyasız", "read": "an-[föö]-nişt", "type": "sıfat", "level": "B1", "example": "It's cheaper unfurnished.", "exampleTr": "Eşyasız daha ucuz.", "opposite": "furnished" },
    { "en": "bills included", "tr": "faturalar dahil", "read": "[bilz] in-kluu-did", "type": "kalıp", "level": "B1", "example": "The rent is nine hundred pounds, bills included.", "exampleTr": "Kira dokuz yüz pound, faturalar dahil." },
    { "en": "council tax", "tr": "belediye vergisi", "read": "[kaun]-sıl t{a}ks", "type": "isim", "level": "B2", "example": "Is council tax included?", "exampleTr": "Belediye vergisi dahil mi?", "note": "British" },
    { "en": "I'd like to view the flat", "tr": "Daireyi görmek istiyorum", "read": "ayd layk tı [vyuu] {d}ı fl{a}t", "type": "kalıp", "level": "B1", "example": "I'd like to view the flat this weekend.", "exampleTr": "Daireyi bu hafta sonu görmek istiyorum." },
    { "en": "Is the deposit refundable?", "tr": "Depozito iade ediliyor mu?", "read": "iz {d}ı di-[po]-zit ri-[fan]-dı-bıl", "type": "kalıp", "level": "B2", "example": "Is the deposit refundable when I move out?", "exampleTr": "Çıkarken depozito iade ediliyor mu?" },
    { "en": "boiler", "tr": "kombi", "read": "[boy]-lı", "type": "isim", "level": "B1", "example": "The boiler isn't working.", "exampleTr": "Kombi çalışmıyor.", "note": "British" },
    { "en": "There's no hot water", "tr": "Sıcak su yok", "read": "{d}eez nou [hot] {w}oo-tı", "type": "kalıp", "level": "A2", "example": "There's no hot water since this morning.", "exampleTr": "Bu sabahtan beri sıcak su yok." },
    { "en": "The heating has broken down", "tr": "Kalorifer bozuldu", "read": "{d}ı [hii]-ting ız brou-kın [daun]", "type": "kalıp", "level": "B1", "example": "The heating has broken down and it's freezing.", "exampleTr": "Kalorifer bozuldu ve hava buz gibi." },
    { "en": "damp", "tr": "rutubet; rutubetli", "read": "d{a}mp", "type": "isim", "level": "B2", "example": "There's damp in the bedroom.", "exampleTr": "Yatak odasında rutubet var." },
    { "en": "mould", "tr": "küf", "read": "mould", "type": "isim", "level": "B2", "example": "There's mould on the bathroom wall.", "exampleTr": "Banyo duvarında küf var.", "note": "British yazım; Amerikan: mold" },
    { "en": "blocked", "tr": "tıkalı", "read": "blokt", "type": "sıfat", "level": "B1", "example": "The sink is blocked.", "exampleTr": "Lavabo tıkalı." },
    { "en": "dripping", "tr": "damlayan", "read": "[dri]-ping", "type": "sıfat", "level": "B1", "example": "The tap is dripping.", "exampleTr": "Musluk damlatıyor." },
    { "en": "Could you send someone to fix it?", "tr": "Tamir için birini gönderebilir misiniz?", "read": "kud yu send [sam]-{w}an tı [fiks] it", "type": "kalıp", "level": "B1", "example": "The window won't close. Could you send someone to fix it?", "exampleTr": "Pencere kapanmıyor. Tamir için birini gönderebilir misiniz?" },
    { "en": "When can you come?", "tr": "Ne zaman gelebilirsiniz?", "read": "{w}en kın yu [kam]", "type": "kalıp", "level": "A2", "example": "When can you come to look at it?", "exampleTr": "Bakmak için ne zaman gelebilirsiniz?" },
    { "en": "It's urgent", "tr": "Acil", "read": "its [öö]-cınt", "type": "kalıp", "level": "B1", "example": "There's water everywhere. It's urgent!", "exampleTr": "Her yer su. Acil!" },
    { "en": "give notice", "tr": "çıkış bildirmek (ihbar)", "read": "giv [nou]-tis", "type": "kalıp", "level": "B2", "example": "I need to give one month's notice before I move out.", "exampleTr": "Çıkmadan bir ay önce bildirmem gerekiyor." },
    { "en": "utilities", "tr": "faturalar (su, elektrik, gaz)", "read": "yuu-[ti]-lı-tiz", "type": "isim", "level": "B2", "example": "How much are the utilities per month?", "exampleTr": "Faturalar aylık ne kadar?" },
    { "en": "landlord", "ref": "landlord" },
    { "en": "rent", "ref": "rent" },
    { "en": "deposit", "ref": "deposit" },
    { "en": "leak", "ref": "leak" },
    { "en": "plumber", "ref": "plumber" },
    { "en": "move in", "ref": "move in" },
    { "en": "notice", "ref": "notice" }
  ]
}
