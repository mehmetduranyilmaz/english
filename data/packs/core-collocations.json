{
  "id": "core-collocations",
  "group": "core",
  "title": "Kalıplar 6: make, do, take, get, have",
  "level": "B1",
  "intro": "<p>Türkçede hepsine “yapmak / almak” deriz; İngilizcede hangi fiilin hangi isimle geldiği sabittir ve ezberlenir. ✘ do a decision → ✔ <b>make</b> a decision. ✘ make homework → ✔ <b>do</b> homework.</p>",
  "words": [
    { "en": "make a decision", "tr": "karar vermek", "read": "meyk ı di-[si]-jın", "type": "kalıp", "level": "B1", "example": "We need to make a decision today.", "exampleTr": "Bugün karar vermemiz lazım." },
    { "en": "make a mistake", "tr": "hata yapmak", "read": "meyk ı mi-[steyk]", "type": "kalıp", "level": "A2", "example": "Everyone makes mistakes.", "exampleTr": "Herkes hata yapar." },
    { "en": "make money", "tr": "para kazanmak", "read": "meyk [ma]-ni", "type": "kalıp", "level": "A2", "example": "How does the app make money?", "exampleTr": "Uygulama nasıl para kazanıyor?" },
    { "en": "make friends", "tr": "arkadaş edinmek", "read": "meyk [frendz]", "type": "kalıp", "level": "A2", "example": "It's hard to make friends in a new city.", "exampleTr": "Yeni bir şehirde arkadaş edinmek zor." },
    { "en": "make sure", "tr": "emin olmak", "read": "meyk [şoo]", "type": "kalıp", "level": "B1", "example": "Make sure you save your work.", "exampleTr": "Çalışmanı kaydettiğinden emin ol." },
    { "en": "make progress", "tr": "ilerleme kaydetmek", "read": "meyk [prou]-gres", "type": "kalıp", "level": "B1", "example": "You're making great progress!", "exampleTr": "Harika ilerliyorsun!" },
    { "en": "make an effort", "tr": "çaba göstermek", "read": "meyk ın [e]-fıt", "type": "kalıp", "level": "B1", "example": "Please make an effort to be on time.", "exampleTr": "Lütfen zamanında gelmek için çaba göster." },
    { "en": "make a phone call", "tr": "telefon görüşmesi yapmak", "read": "meyk ı [foun] kool", "type": "kalıp", "level": "A2", "example": "I need to make a phone call.", "exampleTr": "Bir telefon görüşmesi yapmam lazım." },
    { "en": "do the shopping", "tr": "alışveriş yapmak (market)", "read": "duu {d}ı [şo]-ping", "type": "kalıp", "level": "A2", "example": "I do the shopping on Saturdays.", "exampleTr": "Market alışverişini cumartesi yaparım.", "note": "British" },
    { "en": "do your best", "tr": "elinden geleni yapmak", "read": "duu yoo [best]", "type": "kalıp", "level": "A2", "example": "Just do your best.", "exampleTr": "Sadece elinden geleni yap." },
    { "en": "do business", "tr": "iş yapmak, ticaret yapmak", "read": "duu [biz]-nıs", "type": "kalıp", "level": "B1", "example": "We do business with companies in Germany.", "exampleTr": "Almanya'daki şirketlerle iş yapıyoruz." },
    { "en": "do me a favour", "tr": "bana bir iyilik yap", "read": "duu mi ı [fey]-vı", "type": "kalıp", "level": "B1", "example": "Can you do me a favour?", "exampleTr": "Bana bir iyilik yapar mısın?", "note": "British yazım" },
    { "en": "do research", "tr": "araştırma yapmak", "read": "duu ri-[sööç]", "type": "kalıp", "level": "B1", "example": "I did some research before buying.", "exampleTr": "Almadan önce biraz araştırma yaptım." },
    { "en": "take a break", "tr": "mola vermek", "read": "teyk ı [breyk]", "type": "kalıp", "level": "A2", "example": "Let's take a ten-minute break.", "exampleTr": "On dakika mola verelim." },
    { "en": "take a photo", "tr": "fotoğraf çekmek", "read": "teyk ı [fou]-tou", "type": "kalıp", "level": "A2", "example": "Can you take a photo of us?", "exampleTr": "Bizim fotoğrafımızı çekebilir misin?" },
    { "en": "take time", "tr": "zaman almak", "read": "teyk [taym]", "type": "kalıp", "level": "B1", "example": "Learning a language takes time.", "exampleTr": "Dil öğrenmek zaman alır." },
    { "en": "take part in", "tr": "katılmak", "read": "teyk [paat] in", "type": "kalıp", "level": "B1", "example": "I took part in a hackathon.", "exampleTr": "Bir hackathon'a katıldım." },
    { "en": "take place", "tr": "gerçekleşmek, yapılmak", "read": "teyk [pleys]", "type": "kalıp", "level": "B1", "example": "The conference takes place in May.", "exampleTr": "Konferans mayısta yapılıyor." },
    { "en": "take care of", "tr": "ilgilenmek, bakmak", "read": "teyk [kee] ıv", "type": "kalıp", "level": "B1", "example": "I'll take care of it.", "exampleTr": "Ben ilgilenirim." },
    { "en": "get a job", "tr": "iş bulmak", "read": "get ı [cob]", "type": "kalıp", "level": "A2", "example": "She got a job in London.", "exampleTr": "Londra'da iş buldu." },
    { "en": "get better", "tr": "iyileşmek, gelişmek", "read": "get [be]-tı", "type": "kalıp", "level": "A2", "example": "Your English is getting better.", "exampleTr": "İngilizcen gelişiyor.", "opposite": "get worse" },
    { "en": "get worse", "tr": "kötüleşmek", "read": "get [{w}öös]", "type": "kalıp", "level": "B1", "example": "The traffic is getting worse.", "exampleTr": "Trafik kötüleşiyor.", "opposite": "get better" },
    { "en": "get home", "tr": "eve varmak", "read": "get [houm]", "type": "kalıp", "level": "A2", "example": "Text me when you get home.", "exampleTr": "Eve varınca bana mesaj at." },
    { "en": "get angry", "tr": "sinirlenmek", "read": "get [{a}n]-gri", "type": "kalıp", "level": "A2", "example": "Don't get angry.", "exampleTr": "Sinirlenme." },
    { "en": "have fun", "tr": "eğlenmek", "read": "h{a}v [fan]", "type": "kalıp", "level": "A2", "example": "Have fun at the party!", "exampleTr": "Partide iyi eğlenceler!" },
    { "en": "have a look", "tr": "bir bakmak", "read": "h{a}v ı [luk]", "type": "kalıp", "level": "A2", "example": "Let me have a look.", "exampleTr": "Bir bakayım." },
    { "en": "have a go", "tr": "bir denemek", "read": "h{a}v ı [gou]", "type": "kalıp", "level": "B1", "example": "Can I have a go?", "exampleTr": "Ben de bir deneyebilir miyim?", "note": "British" },
    { "en": "have a word with", "tr": "biriyle kısaca konuşmak", "read": "h{a}v ı [{w}ööd] {w}i{d}", "type": "kalıp", "level": "B2", "example": "Can I have a word with you?", "exampleTr": "Seninle bir dakika konuşabilir miyim?", "note": "British" },
    { "en": "pay attention", "tr": "dikkat etmek", "read": "pey ı-[ten]-şın", "type": "kalıp", "level": "B1", "example": "Pay attention to the details.", "exampleTr": "Ayrıntılara dikkat et.", "note": "✘ give attention" },
    { "en": "keep calm", "tr": "sakin kalmak", "read": "kiip [kaam]", "type": "kalıp", "level": "B1", "example": "Keep calm and carry on.", "exampleTr": "Sakin ol ve devam et.", "note": "Ünlü British sloganı" }
  ]
}
