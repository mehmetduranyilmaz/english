{
  "id": "core-situation-bank",
  "group": "core",
  "title": "Durum 1: bankada",
  "level": "B1",
  "intro": "<p><b>British banka terimleri:</b> vadesiz hesap = <b>current account</b> (Amerikan: checking account), şube / hesap kodu = <b>sort code</b>, otomatik ödeme talimatı = <b>direct debit</b>, eksi bakiye = <b>overdraft</b>, temassız ödeme = <b>contactless</b>.</p>",
  "words": [
    { "en": "I'd like to open an account", "tr": "Hesap açmak istiyorum", "read": "ayd layk tı [ou]-pın ın ı-[kaunt]", "type": "kalıp", "level": "B1", "example": "Hello, I'd like to open an account.", "exampleTr": "Merhaba, hesap açmak istiyorum." },
    { "en": "current account", "tr": "vadesiz hesap", "read": "[ka]-rınt ı-kaunt", "type": "isim", "level": "B1", "example": "My salary goes into my current account.", "exampleTr": "Maaşım vadesiz hesabıma yatıyor.", "note": "British; Amerikan: checking account" },
    { "en": "savings account", "tr": "birikim hesabı", "read": "[sey]-vingz ı-kaunt", "type": "isim", "level": "B1", "example": "I put money into a savings account.", "exampleTr": "Birikim hesabına para koyuyorum." },
    { "en": "sort code", "tr": "banka şube kodu", "read": "[soot] koud", "type": "isim", "level": "B2", "example": "What's your sort code and account number?", "exampleTr": "Şube kodun ve hesap numaran ne?", "note": "British" },
    { "en": "balance", "tr": "bakiye; denge", "read": "[b{a}]-lıns", "type": "isim", "level": "B1", "example": "Can I check my balance?", "exampleTr": "Bakiyeme bakabilir miyim?" },
    { "en": "withdraw", "tr": "para çekmek", "read": "{w}i{d}-[droo]", "type": "fiil", "level": "B1", "example": "I'd like to withdraw two hundred pounds.", "exampleTr": "İki yüz pound çekmek istiyorum.", "note": "withdrew, withdrawn" },
    { "en": "deposit", "tr": "para yatırmak; depozito", "read": "di-[po]-zit", "type": "fiil", "level": "B1", "example": "I'd like to deposit this cheque.", "exampleTr": "Bu çeki yatırmak istiyorum." },
    { "en": "transfer", "tr": "havale etmek; havale", "read": "tr{a}ns-[föö]", "type": "fiil", "level": "B1", "example": "I've transferred the money to your account.", "exampleTr": "Parayı hesabına havale ettim.", "note": "isim olarak vurgu başta: a «[tr{a}ns]-föö»" },
    { "en": "fee", "tr": "ücret, masraf", "read": "fii", "type": "isim", "level": "B1", "example": "Is there a fee for this?", "exampleTr": "Bunun bir ücreti var mı?" },
    { "en": "exchange rate", "tr": "döviz kuru", "read": "iks-[çeync] reyt", "type": "isim", "level": "B1", "example": "What's the exchange rate today?", "exampleTr": "Bugün döviz kuru ne?" },
    { "en": "overdraft", "tr": "eksi bakiye (kredili hesap)", "read": "[ou]-vı-draaft", "type": "isim", "level": "B2", "example": "I'm in my overdraft this month.", "exampleTr": "Bu ay hesabım ekside.", "note": "British" },
    { "en": "direct debit", "tr": "otomatik ödeme talimatı", "read": "dı-[rekt] [de]-bit", "type": "isim", "level": "B2", "example": "I pay my bills by direct debit.", "exampleTr": "Faturalarımı otomatik ödemeyle ödüyorum.", "note": "British" },
    { "en": "contactless", "tr": "temassız (ödeme)", "read": "[kon]-t{a}kt-lıs", "type": "sıfat", "level": "B1", "example": "Can I pay contactless?", "exampleTr": "Temassız ödeyebilir miyim?", "note": "British" },
    { "en": "debit card", "tr": "banka kartı", "read": "[de]-bit kaad", "type": "isim", "level": "B1", "example": "Can I use my debit card?", "exampleTr": "Banka kartımı kullanabilir miyim?", "opposite": "credit card" },
    { "en": "credit card", "tr": "kredi kartı", "read": "[kre]-dit kaad", "type": "isim", "level": "A2", "example": "Do you accept credit cards?", "exampleTr": "Kredi kartı geçiyor mu?", "opposite": "debit card" },
    { "en": "My card has been blocked", "tr": "Kartım bloke oldu", "read": "may [kaad] ız biin [blokt]", "type": "kalıp", "level": "B1", "example": "My card has been blocked. Can you help?", "exampleTr": "Kartım bloke oldu. Yardım edebilir misiniz?" },
    { "en": "The cash machine kept my card", "tr": "Bankamatik kartımı yuttu", "read": "{d}ı [k{a}ş] mı-şiin kept may [kaad]", "type": "kalıp", "level": "B1", "example": "The cash machine kept my card. What should I do?", "exampleTr": "Bankamatik kartımı yuttu. Ne yapmalıyım?" },
    { "en": "There's a mistake on my statement", "tr": "Hesap özetimde bir hata var", "read": "{d}eez ı mi-[steyk] on may [steyt]-mınt", "type": "kalıp", "level": "B2", "example": "I think there's a mistake on my statement.", "exampleTr": "Sanırım hesap özetimde bir hata var." },
    { "en": "I'd like to report a lost card", "tr": "Kayıp kart bildirmek istiyorum", "read": "ayd layk tı ri-[poot] ı lost [kaad]", "type": "kalıp", "level": "B1", "example": "I'd like to report a lost card, please.", "exampleTr": "Kayıp kart bildirmek istiyorum, lütfen." },
    { "en": "online banking", "tr": "internet bankacılığı", "read": "on-layn [b{a}n]-king", "type": "isim", "level": "B1", "example": "I do everything with online banking.", "exampleTr": "Her şeyi internet bankacılığıyla yapıyorum." },
    { "en": "cheque", "tr": "çek", "read": "çek", "type": "isim", "level": "B2", "example": "Nobody pays by cheque any more.", "exampleTr": "Artık kimse çekle ödemiyor.", "note": "British yazım; Amerikan: check" },
