{
  "id": "dev-meetings",
  "group": "dev",
  "title": "Yazılım 9: toplantı kalıpları",
  "level": "B1",
  "intro": "<p>Online toplantılarda ve stand-up'larda en çok kullanılan cümleler. Bunları ezberleyin; toplantıda düşünmeden söyleyebilmek büyük özgüven verir.</p>",
  "words": [
    { "en": "Let's get started", "tr": "Başlayalım", "read": "lets get [staa]-tid", "type": "kalıp", "level": "B1", "example": "OK, everyone's here. Let's get started.", "exampleTr": "Tamam, herkes burada. Başlayalım." },
    { "en": "Can everyone hear me?", "tr": "Herkes beni duyabiliyor mu?", "read": "kın [ev]-ri-{w}an [hiı] mi", "type": "kalıp", "level": "B1", "example": "Can everyone hear me? Great.", "exampleTr": "Herkes beni duyabiliyor mu? Harika." },
    { "en": "Can you see my screen?", "tr": "Ekranımı görebiliyor musunuz?", "read": "kın yu sii may [skriin]", "type": "kalıp", "level": "B1", "example": "I'm sharing now. Can you see my screen?", "exampleTr": "Şimdi paylaşıyorum. Ekranımı görebiliyor musunuz?" },
    { "en": "I'll share my screen", "tr": "Ekranımı paylaşayım", "read": "ayl [şee] may skriin", "type": "kalıp", "level": "B1", "example": "Let me show you. I'll share my screen.", "exampleTr": "Size göstereyim. Ekranımı paylaşayım." },
    { "en": "You're on mute", "tr": "Mikrofonun kapalı", "read": "yoo on [myuut]", "type": "kalıp", "level": "B1", "example": "Sorry, Tom, you're on mute.", "exampleTr": "Pardon Tom, mikrofonun kapalı." },
    { "en": "You've frozen", "tr": "Görüntün dondu", "read": "yuuv [frou]-zın", "type": "kalıp", "level": "B1", "example": "I think you've frozen.", "exampleTr": "Sanırım görüntün dondu." },
    { "en": "You're breaking up", "tr": "Sesin kesik kesik geliyor", "read": "yoo [brey]-king ap", "type": "kalıp", "level": "B1", "example": "Sorry, you're breaking up.", "exampleTr": "Pardon, sesin kesik geliyor." },
    { "en": "Let's take this offline", "tr": "Bunu toplantı dışında konuşalım", "read": "lets teyk {d}is of-[layn]", "type": "kalıp", "level": "B2", "example": "Good point, but let's take this offline.", "exampleTr": "İyi nokta ama bunu ayrıca konuşalım." },
    { "en": "Let's circle back to this", "tr": "Buna sonra dönelim", "read": "lets [söö]-kıl [b{a}k] tı {d}is", "type": "kalıp", "level": "B2", "example": "We're short on time. Let's circle back to this.", "exampleTr": "Vaktimiz az. Buna sonra dönelim." },
    { "en": "Let's park that for now", "tr": "Şimdilik bunu kenara koyalım", "read": "lets [paak] {d}{a}t fı [nau]", "type": "kalıp", "level": "B2", "example": "Interesting idea, but let's park that for now.", "exampleTr": "İlginç fikir ama şimdilik kenara koyalım.", "note": "British" },
    { "en": "I'll get back to you", "tr": "Sana dönüş yapacağım", "read": "ayl get [b{a}k] tı yu", "type": "kalıp", "level": "B1", "example": "I'm not sure. I'll get back to you.", "exampleTr": "Emin değilim. Sana dönüş yapacağım." },
    { "en": "Can you walk me through it?", "tr": "Bana adım adım anlatır mısın?", "read": "kın yu [{w}ook] mi {t}ruu it", "type": "kalıp", "level": "B2", "example": "I don't get the flow. Can you walk me through it?", "exampleTr": "Akışı anlamadım. Adım adım anlatır mısın?" },
    { "en": "Any questions?", "tr": "Soru var mı?", "read": "e-ni [k{w}es]-çınz", "type": "kalıp", "level": "A2", "example": "That's all from me. Any questions?", "exampleTr": "Benden bu kadar. Soru var mı?" },
    { "en": "Just to add to that", "tr": "Buna ek olarak", "read": "cast tı [{a}d] tı {d}{a}t", "type": "kalıp", "level": "B2", "example": "Just to add to that, the API is also slow.", "exampleTr": "Buna ek olarak, API de yavaş." },
    { "en": "Sorry, go ahead", "tr": "Pardon, sen devam et", "read": "[so]-ri gou ı-[hed]", "type": "kalıp", "level": "B1", "example": "Oh, sorry, go ahead.", "exampleTr": "Ah, pardon, sen devam et.", "note": "İki kişi aynı anda konuşunca" },
    { "en": "We're running out of time", "tr": "Vaktimiz azalıyor", "read": "{w}iı [ra]-ning [aut] ıv taym", "type": "kalıp", "level": "B1", "example": "We're running out of time, so let's be quick.", "exampleTr": "Vaktimiz azalıyor, hızlı olalım." },
    { "en": "Let's wrap up", "tr": "Toparlayalım", "read": "lets [r{a}p] ap", "type": "kalıp", "level": "B2", "example": "OK, let's wrap up.", "exampleTr": "Tamam, toparlayalım.", "note": "w okunmaz" },
    { "en": "What are the next steps?", "tr": "Sonraki adımlar ne?", "read": "{w}ot aa {d}ı nekst [steps]", "type": "kalıp", "level": "B1", "example": "Before we finish, what are the next steps?", "exampleTr": "Bitirmeden önce, sonraki adımlar ne?" },
    { "en": "Who's going to own this?", "tr": "Bunun sorumluluğunu kim alacak?", "read": "huuz [gou]-ing tı [oun] {d}is", "type": "kalıp", "level": "B2", "example": "Great idea. Who's going to own this?", "exampleTr": "Harika fikir. Kim üstlenecek?" },
    { "en": "I'll follow up by email", "tr": "E-postayla takip edeceğim", "read": "ayl fo-lou [ap] bay [ii]-meyl", "type": "kalıp", "level": "B2", "example": "I'll follow up by email with the details.", "exampleTr": "Ayrıntıları e-postayla ileteceğim." },
    { "en": "Does anyone have any blockers?", "tr": "Engeli olan var mı?", "read": "daz [e]-ni-{w}an h{a}v e-ni [blo]-kız", "type": "kalıp", "level": "B1", "example": "Before we finish, does anyone have any blockers?", "exampleTr": "Bitirmeden önce, engeli olan var mı?" },
    { "en": "Yesterday I…, today I'll…", "tr": "Dün şunu yaptım, bugün şunu yapacağım", "read": "[yes]-tı-dey ay … tı-[dey] ayl", "type": "kalıp", "level": "B1", "example": "Yesterday I fixed the login bug, today I'll work on the tests.", "exampleTr": "Dün giriş hatasını düzelttim, bugün testler üzerinde çalışacağım.", "note": "Stand-up kalıbı" },
    { "en": "It's still in progress", "tr": "Hâlâ devam ediyor", "read": "its stil in [prou]-gres", "type": "kalıp", "level": "B1", "example": "The new feature is still in progress.", "exampleTr": "Yeni özellik hâlâ devam ediyor." },
    { "en": "It's done and merged", "tr": "Bitti ve birleştirildi", "read": "its [dan] ın [möömd]", "type": "kalıp", "level": "B1", "example": "The fix? It's done and merged.", "exampleTr": "Düzeltme mi? Bitti ve birleştirildi." },
    { "en": "I'm blocked by…", "tr": "… yüzünden ilerleyemiyorum", "read": "aym [blokt] bay", "type": "kalıp", "level": "B2", "example": "I'm blocked by the API changes.", "exampleTr": "API değişiklikleri yüzünden ilerleyemiyorum." },
    { "en": "Can we push the deadline?", "tr": "Son tarihi erteleyebilir miyiz?", "read": "kın {w}i [puş] {d}ı [ded]-layn", "type": "kalıp", "level": "B2", "example": "It's more complex than we thought. Can we push the deadline?", "exampleTr": "Düşündüğümüzden karmaşık. Son tarihi erteleyebilir miyiz?" },
    { "en": "Let's sync up later", "tr": "Sonra konuşup eşgüdüm sağlayalım", "read": "lets [sink] ap [ley]-tı", "type": "kalıp", "level": "B2", "example": "I've got another call. Let's sync up later.", "exampleTr": "Başka bir görüşmem var. Sonra konuşalım." },
    { "en": "That's out of scope", "tr": "Bu kapsam dışında", "read": "{d}{a}ts aut ıv [skoup]", "type": "kalıp", "level": "B2", "example": "Dark mode? That's out of scope for this release.", "exampleTr": "Karanlık mod mu? Bu sürümün kapsamı dışında." },
    { "en": "Thanks, everyone", "tr": "Herkese teşekkürler", "read": "{t}{a}nks [ev]-ri-{w}an", "type": "kalıp", "level": "A2", "example": "Thanks, everyone. Have a good day!", "exampleTr": "Herkese teşekkürler. İyi günler!" }
  ]
}
