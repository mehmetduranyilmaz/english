{
  "id": "core-adverbs",
  "group": "core",
  "title": "Zarflar: really, actually, still…",
  "level": "A2",
  "intro": "<p>Konuşmayı doğal yapan küçük kelimeler. <b>Sahte arkadaşlar:</b> <b>actually</b> = aslında (aktüel değil), <b>eventually</b> = sonunda (eventüel değil), <b>hardly</b> = neredeyse hiç (zorlukla değil).</p>",
  "words": [
    { "en": "really", "tr": "gerçekten; çok", "read": "[riı]-li", "type": "zarf", "level": "A1", "example": "I really like it.", "exampleTr": "Gerçekten beğendim." },
    { "en": "actually", "tr": "aslında", "read": "[{a}k]-çu-ı-li", "type": "zarf", "level": "A2", "example": "Actually, I've changed my mind.", "exampleTr": "Aslında fikrimi değiştirdim.", "note": "Sahte arkadaş! “şu an” değil" },
    { "en": "also", "tr": "ayrıca, de / da", "read": "[ool]-sou", "type": "zarf", "level": "A1", "example": "I also speak German.", "exampleTr": "Almanca da konuşurum." },
    { "en": "only", "tr": "sadece", "read": "[oun]-li", "type": "zarf", "level": "A1", "example": "It only takes five minutes.", "exampleTr": "Sadece beş dakika sürüyor." },
    { "en": "even", "tr": "bile", "read": "[ii]-vın", "type": "zarf", "level": "A2", "example": "Even my mum uses WhatsApp.", "exampleTr": "Annem bile WhatsApp kullanıyor." },
    { "en": "still", "tr": "hâlâ", "read": "stil", "type": "zarf", "level": "A2", "example": "Are you still at work?", "exampleTr": "Hâlâ işte misin?" },
    { "en": "too", "tr": "de / da; fazla, çok", "read": "tuu", "type": "zarf", "level": "A1", "example": "It's too expensive.", "exampleTr": "Fazla pahalı.", "note": "two ve to ile aynı okunur" },
    { "en": "quite", "tr": "oldukça", "read": "k{w}ayt", "type": "zarf", "level": "A2", "example": "It's quite cold today.", "exampleTr": "Bugün hava oldukça soğuk.", "note": "quiet (sessiz) ile karışmasın" },
    { "en": "rather", "tr": "oldukça; tercihen", "read": "[raa]-{d}ı", "type": "zarf", "level": "B1", "example": "I'd rather stay at home.", "exampleTr": "Evde kalmayı tercih ederim." },
    { "en": "almost", "tr": "neredeyse", "read": "[ool]-moust", "type": "zarf", "level": "A2", "example": "I'm almost ready.", "exampleTr": "Neredeyse hazırım." },
    { "en": "exactly", "tr": "tam olarak; aynen!", "read": "ig-[z{a}kt]-li", "type": "zarf", "level": "A2", "example": "Exactly! That's what I mean.", "exampleTr": "Aynen! Demek istediğim bu." },
    { "en": "especially", "tr": "özellikle", "read": "i-[spe]-şı-li", "type": "zarf", "level": "B1", "example": "I love London, especially in spring.", "exampleTr": "Londra'yı seviyorum, özellikle baharda." },
    { "en": "together", "tr": "birlikte", "read": "tı-[ge]-{d}ı", "type": "zarf", "level": "A2", "example": "Let's work on it together.", "exampleTr": "Bunun üzerinde birlikte çalışalım." },
    { "en": "instead", "tr": "onun yerine", "read": "in-[sted]", "type": "zarf", "level": "B1", "example": "Let's have tea instead.", "exampleTr": "Onun yerine çay içelim." },
    { "en": "anyway", "tr": "neyse; yine de", "read": "[e]-ni-{w}ey", "type": "zarf", "level": "B1", "example": "Anyway, let's get back to work.", "exampleTr": "Neyse, işe dönelim." },
    { "en": "away", "tr": "uzakta, uzağa", "read": "ı-[{w}ey]", "type": "zarf", "level": "A2", "example": "She's away this week.", "exampleTr": "Bu hafta yok (uzakta)." },
    { "en": "quickly", "tr": "hızlıca", "read": "[k{w}ik]-li", "type": "zarf", "level": "A2", "example": "Can you check it quickly?", "exampleTr": "Hızlıca kontrol edebilir misin?" },
    { "en": "carefully", "tr": "dikkatlice", "read": "[kee]-fı-li", "type": "zarf", "level": "B1", "example": "Read the instructions carefully.", "exampleTr": "Talimatları dikkatlice oku." },
    { "en": "hardly", "tr": "neredeyse hiç", "read": "[haad]-li", "type": "zarf", "level": "B1", "example": "I hardly slept last night.", "exampleTr": "Dün gece neredeyse hiç uyumadım.", "note": "Sahte arkadaş! “zorlukla” değil" },
    { "en": "nearly", "tr": "neredeyse", "read": "[niı]-li", "type": "zarf", "level": "B1", "example": "It's nearly midnight.", "exampleTr": "Neredeyse gece yarısı." },
    { "en": "immediately", "tr": "hemen", "read": "i-[mii]-di-ıt-li", "type": "zarf", "level": "B1", "example": "Call me immediately.", "exampleTr": "Beni hemen ara." },
    { "en": "eventually", "tr": "sonunda", "read": "i-[ven]-çu-ı-li", "type": "zarf", "level": "B1", "example": "Eventually, we found the bug.", "exampleTr": "Sonunda hatayı bulduk.", "note": "Sahte arkadaş! “belki” değil" },
    { "en": "basically", "tr": "temelde, kısacası", "read": "[bey]-sik-li", "type": "zarf", "level": "B1", "example": "Basically, it doesn't work.", "exampleTr": "Kısacası, çalışmıyor." },
    { "en": "clearly", "tr": "açıkça", "read": "[kliı]-li", "type": "zarf", "level": "B1", "example": "Please speak clearly.", "exampleTr": "Lütfen net konuşun." },
    { "en": "completely", "tr": "tamamen", "read": "kım-[pliit]-li", "type": "zarf", "level": "B1", "example": "I completely forgot.", "exampleTr": "Tamamen unuttum." },
    { "en": "seriously", "tr": "ciddi olarak; cidden", "read": "[siı]-ri-ıs-li", "type": "zarf", "level": "B1", "example": "Seriously? I didn't know that.", "exampleTr": "Cidden mi? Bilmiyordum." },
    { "en": "simply", "tr": "basitçe, sadece", "read": "[sim]-pli", "type": "zarf", "level": "B1", "example": "Simply click here.", "exampleTr": "Sadece buraya tıklayın." },
    { "en": "certainly", "tr": "kesinlikle, elbette", "read": "[söö]-tın-li", "type": "zarf", "level": "B1", "example": "Can you help? — Certainly!", "exampleTr": "Yardım eder misin? — Elbette!" },
    { "en": "luckily", "tr": "neyse ki", "read": "[la]-ki-li", "type": "zarf", "level": "B1", "example": "Luckily, nobody was hurt.", "exampleTr": "Neyse ki kimse yaralanmadı." },
    { "en": "ahead", "tr": "ileride, önde", "read": "ı-[hed]", "type": "zarf", "level": "B1", "example": "Go ahead!", "exampleTr": "Buyur, devam et!" }
  ]
}
