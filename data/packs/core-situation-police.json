  "title": "Durum 3: polise bildirme ve kayıp eşya",
  "level": "B1",
  "intro": "<p><b>Britanya'da:</b> acil durumda <b>999</b>, acil olmayan durumlar için <b>101</b> aranır. Sigorta için polisten <b>crime reference number</b> (olay numarası) isteyin. Pasaport kaybında konsolosluğa (<b>consulate</b>) başvurulur.</p>",
  "words": [
    { "en": "I'd like to report a theft", "tr": "Hırsızlık bildirmek istiyorum", "read": "ayd layk tı ri-[poot] ı [{t}eft]", "type": "kalıp", "level": "B1", "example": "Good afternoon. I'd like to report a theft.", "exampleTr": "İyi günler. Hırsızlık bildirmek istiyorum." },
    { "en": "theft", "tr": "hırsızlık", "read": "{t}eft", "type": "isim", "level": "B1", "example": "Bike theft is common in cities.", "exampleTr": "Şehirlerde bisiklet hırsızlığı yaygın." },
    { "en": "My wallet has been stolen", "tr": "Cüzdanım çalındı", "read": "may [{w}o]-lit ız biin [stou]-lın", "type": "kalıp", "level": "B1", "example": "My wallet has been stolen on the tube.", "exampleTr": "Cüzdanım metroda çalındı." },
    { "en": "I've lost my passport", "tr": "Pasaportumu kaybettim", "read": "ayv lost may [paas]-poot", "type": "kalıp", "level": "B1", "example": "I've lost my passport. What should I do?", "exampleTr": "Pasaportumu kaybettim. Ne yapmalıyım?" },
    { "en": "It happened about an hour ago", "tr": "Yaklaşık bir saat önce oldu", "read": "it [h{a}]-pınd ı-baut ın [au]-ı ı-gou", "type": "kalıp", "level": "B1", "example": "It happened about an hour ago, near the station.", "exampleTr": "Yaklaşık bir saat önce, istasyonun yakınında oldu." },
    { "en": "I didn't see who did it", "tr": "Kimin yaptığını görmedim", "read": "ay di-dınt [sii] huu did it", "type": "kalıp", "level": "B1", "example": "Sorry, I didn't see who did it.", "exampleTr": "Kusura bakmayın, kimin yaptığını görmedim." },
    { "en": "It's a black leather bag", "tr": "Siyah deri bir çanta", "read": "its ı bl{a}k [le]-{d}ı b{a}g", "type": "kalıp", "level": "B1", "example": "It's a black leather bag with a laptop inside.", "exampleTr": "İçinde laptop olan siyah deri bir çanta." },
    { "en": "leather", "tr": "deri", "read": "[le]-{d}ı", "type": "isim", "level": "B1", "example": "a leather jacket", "exampleTr": "deri ceket" },
    { "en": "crime reference number", "tr": "olay (suç) kayıt numarası", "read": "[kraym] ref-rıns [nam]-bı", "type": "isim", "level": "B2", "example": "Can I have a crime reference number for my insurance?", "exampleTr": "Sigortam için olay numarası alabilir miyim?", "note": "British" },
    { "en": "insurance", "tr": "sigorta", "read": "in-[şuı]-rıns", "type": "isim", "level": "B1", "example": "Is it covered by your insurance?", "exampleTr": "Sigortan karşılıyor mu?" },
    { "en": "pickpocket", "tr": "yankesici", "read": "[pik]-po-kit", "type": "isim", "level": "B2", "example": "Watch out for pickpockets.", "exampleTr": "Yankesicilere dikkat edin." },
    { "en": "burglary", "tr": "ev soyma", "read": "[böö]-glı-ri", "type": "isim", "level": "B2", "example": "There was a burglary next door.", "exampleTr": "Yan evi soydular." },
    { "en": "burglar", "tr": "ev hırsızı", "read": "[böö]-glı", "type": "isim", "level": "B2", "example": "The burglar broke a window.", "exampleTr": "Hırsız bir camı kırdı." },
    { "en": "lost", "tr": "kayıp; kaybolmuş", "read": "lost", "type": "sıfat", "level": "A2", "example": "I'm looking for a lost phone.", "exampleTr": "Kayıp bir telefon arıyorum." },
    { "en": "Has anyone handed in a phone?", "tr": "Teslim edilen bir telefon var mı?", "read": "h{a}z [e]-ni-{w}an h{a}n-did [in] ı foun", "type": "kalıp", "level": "B2", "example": "Excuse me, has anyone handed in a phone?", "exampleTr": "Afedersiniz, teslim edilen bir telefon var mı?" },
    { "en": "embassy", "tr": "büyükelçilik", "read": "[em]-bı-si", "type": "isim", "level": "B2", "example": "Contact the Turkish embassy.", "exampleTr": "Türk büyükelçiliğiyle iletişime geçin." },
