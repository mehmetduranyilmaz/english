    { "en": "Help!", "tr": "İmdat!", "read": "[help]", "type": "kalıp", "level": "A1", "example": "Help! Someone's taken my bag!", "exampleTr": "İmdat! Biri çantamı aldı!" },
    { "en": "Stop, thief!", "tr": "Durdurun, hırsız!", "read": "stop [{t}iif]", "type": "kalıp", "level": "B1", "example": "Stop, thief!", "exampleTr": "Durdurun, hırsız!" },
