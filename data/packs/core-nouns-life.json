    { "en": "kid", "tr": "çocuk (günlük)", "read": "kid", "type": "isim", "level": "A2", "example": "Have you got kids?", "exampleTr": "Çocuğun var mı?" },
    { "en": "grandparents", "tr": "büyükanne ve büyükbaba", "read": "[gr{a}n]-pee-rınts", "type": "isim", "level": "A1", "example": "I visit my grandparents every Sunday.", "exampleTr": "Her pazar büyükannemle büyükbabamı ziyaret ederim.", "note": "grandma, grandad (British) da denir" },
