    { "en": "age", "tr": "yaş; çağ", "read": "eyc", "type": "isim", "level": "A2", "example": "At your age, I was already working.", "exampleTr": "Senin yaşında ben çoktan çalışıyordum." },
    { "en": "member", "tr": "üye", "read": "[mem]-bı", "type": "isim", "level": "B1", "example": "She's a member of our team.", "exampleTr": "Ekibimizin bir üyesi." },
