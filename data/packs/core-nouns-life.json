    { "en": "uncle", "tr": "amca, dayı", "read": "[an]-kıl", "type": "isim", "level": "A2", "example": "My uncle has a shop.", "exampleTr": "Amcamın bir dükkânı var." },
    { "en": "nephew", "tr": "erkek yeğen", "read": "[ne]-fyuu", "type": "isim", "level": "B1", "example": "My nephew is five.", "exampleTr": "Yeğenim beş yaşında.", "opposite": "niece" },
    { "en": "niece", "tr": "kız yeğen", "read": "niis", "type": "isim", "level": "B1", "example": "My niece loves drawing.", "exampleTr": "Yeğenim resim yapmayı seviyor.", "opposite": "nephew" },
    { "en": "relative", "tr": "akraba", "read": "[re]-lı-tiv", "type": "isim", "level": "B1", "example": "We have relatives in Germany.", "exampleTr": "Almanya'da akrabalarımız var." },
    { "en": "stranger", "tr": "yabancı (tanımadığın kişi)", "read": "[streyn]-cı", "type": "isim", "level": "B1", "example": "Don't talk to strangers.", "exampleTr": "Yabancılarla konuşma.", "note": "foreigner = başka ülkeden; stranger = tanımadığın kişi" }
