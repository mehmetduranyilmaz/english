{
  "id": "core-determiners",
  "group": "core",
  "title": "Herkes, hiçbir şey, her ikisi: zamir ve bağlaçlar",
  "level": "A2",
  "intro": "<p><b>some- / any- / no- / every-</b> + <b>-thing</b> (şey), <b>-one / -body</b> (kişi), <b>-where</b> (yer). Kural 6. aşamadaki gibi: olumluda some-, olumsuz ve soruda any-. <b>no-</b> zaten olumsuzdur: I know nobody (✘ I don't know nobody).</p>",
  "words": [
    { "en": "everything", "tr": "her şey", "read": "[ev]-ri-{t}ing", "type": "zamir", "level": "A1", "example": "Everything is ready.", "exampleTr": "Her şey hazır.", "note": "tekil: everything is" },
    { "en": "nothing", "tr": "hiçbir şey", "read": "[na]-{t}ing", "type": "zamir", "level": "A2", "example": "There's nothing in the fridge.", "exampleTr": "Buzdolabında hiçbir şey yok." },
    { "en": "something", "tr": "bir şey", "read": "[sam]-{t}ing", "type": "zamir", "level": "A1", "example": "I want to tell you something.", "exampleTr": "Sana bir şey söylemek istiyorum." },
    { "en": "anything", "tr": "herhangi bir şey; hiçbir şey (olumsuz)", "read": "[e]-ni-{t}ing", "type": "zamir", "level": "A2", "example": "Do you need anything?", "exampleTr": "Bir şeye ihtiyacın var mı?" },
    { "en": "everyone", "tr": "herkes", "read": "[ev]-ri-{w}an", "type": "zamir", "level": "A1", "example": "Everyone likes her.", "exampleTr": "Herkes onu sever.", "note": "tekil: everyone likes; everybody de olur" },
    { "en": "nobody", "tr": "hiç kimse", "read": "[nou]-bı-di", "type": "zamir", "level": "A2", "example": "Nobody answered.", "exampleTr": "Kimse cevap vermedi." },
    { "en": "anyone", "tr": "herhangi biri; kimse (olumsuz)", "read": "[e]-ni-{w}an", "type": "zamir", "level": "A2", "example": "Does anyone have a pen?", "exampleTr": "Kimsede kalem var mı?" },
    { "en": "somewhere", "tr": "bir yer(de)", "read": "[sam]-{w}ee", "type": "zarf", "level": "A2", "example": "Let's go somewhere quiet.", "exampleTr": "Sessiz bir yere gidelim." },
    { "en": "anywhere", "tr": "herhangi bir yer; hiçbir yer (olumsuz)", "read": "[e]-ni-{w}ee", "type": "zarf", "level": "A2", "example": "I can't find it anywhere.", "exampleTr": "Hiçbir yerde bulamıyorum." },
    { "en": "everywhere", "tr": "her yer(de)", "read": "[ev]-ri-{w}ee", "type": "zarf", "level": "A2", "example": "I've looked everywhere.", "exampleTr": "Her yere baktım." },
    { "en": "nowhere", "tr": "hiçbir yer(de)", "read": "[nou]-{w}ee", "type": "zarf", "level": "B1", "example": "There's nowhere to park.", "exampleTr": "Park edecek hiçbir yer yok." },
    { "en": "each", "tr": "her bir", "read": "iiç", "type": "zamir", "level": "A2", "example": "Each room has a TV.", "exampleTr": "Her odada bir televizyon var." },
    { "en": "every", "tr": "her", "read": "[ev]-ri", "type": "zamir", "level": "A1", "example": "I see her every week.", "exampleTr": "Onu her hafta görürüm." },
    { "en": "both", "tr": "her ikisi", "read": "bou{t}", "type": "zamir", "level": "A2", "example": "Both options are fine.", "exampleTr": "İki seçenek de olur." },
    { "en": "either", "tr": "ikisinden biri; (olumsuz) de", "read": "[ay]-{d}ı", "type": "zamir", "level": "B1", "example": "I don't like it either.", "exampleTr": "Ben de sevmiyorum.", "note": "British: “AY-dı”" },
    { "en": "neither", "tr": "hiçbiri (ikisinden)", "read": "[nay]-{d}ı", "type": "zamir", "level": "B1", "example": "Neither of them came.", "exampleTr": "İkisi de gelmedi." },
    { "en": "all", "tr": "hepsi, tüm", "read": "ool", "type": "zamir", "level": "A1", "example": "All my friends were there.", "exampleTr": "Bütün arkadaşlarım oradaydı." },
    { "en": "none", "tr": "hiçbiri", "read": "nan", "type": "zamir", "level": "B1", "example": "None of the tests failed.", "exampleTr": "Testlerin hiçbiri başarısız olmadı." },
    { "en": "other", "tr": "diğer", "read": "[a]-{d}ı", "type": "zamir", "level": "A1", "example": "Where are the other files?", "exampleTr": "Diğer dosyalar nerede?" },
    { "en": "another", "tr": "başka bir; bir … daha", "read": "ı-[na]-{d}ı", "type": "zamir", "level": "A2", "example": "Can I have another coffee?", "exampleTr": "Bir kahve daha alabilir miyim?" },
    { "en": "such", "tr": "öyle, böyle; çok", "read": "saç", "type": "zamir", "level": "B1", "example": "It was such a nice day.", "exampleTr": "Öyle güzel bir gündü ki." },
    { "en": "several", "tr": "birkaç, birçok", "read": "[sev]-rıl", "type": "zamir", "level": "B1", "example": "I've tried several times.", "exampleTr": "Birkaç kez denedim." },
    { "en": "enough", "tr": "yeterli, yeterince", "read": "i-[naf]", "type": "zamir", "level": "A2", "example": "Have we got enough time?", "exampleTr": "Yeterince vaktimiz var mı?", "note": "gh = f" },
    { "en": "else", "tr": "başka", "read": "els", "type": "zarf", "level": "A2", "example": "Anything else?", "exampleTr": "Başka bir şey?" },
    { "en": "though", "tr": "ama, yine de (cümle sonunda)", "read": "{d}ou", "type": "bağlaç", "level": "B1", "example": "It's expensive. It's good, though.", "exampleTr": "Pahalı. Ama iyi." },
    { "en": "besides", "tr": "ayrıca, hem de", "read": "bi-[saydz]", "type": "zarf", "level": "B1", "example": "Besides, it's too late now.", "exampleTr": "Hem ayrıca artık çok geç." },
    { "en": "otherwise", "tr": "aksi halde", "read": "[a]-{d}ı-{w}ayz", "type": "zarf", "level": "B1", "example": "Hurry up, otherwise we'll be late.", "exampleTr": "Acele et, yoksa geç kalacağız." },
    { "en": "instead of", "tr": "… yerine", "read": "in-[sted] ıv", "type": "edat", "level": "B1", "example": "Use tea instead of coffee.", "exampleTr": "Kahve yerine çay kullan." },
    { "en": "apart from", "tr": "… dışında", "read": "ı-[paat] from", "type": "edat", "level": "B1", "example": "Apart from that, everything is fine.", "exampleTr": "Onun dışında her şey yolunda.", "note": "British" },
    { "en": "as well", "tr": "de / da (cümle sonunda)", "read": "ız [{w}el]", "type": "zarf", "level": "B1", "example": "I'd like a coffee as well.", "exampleTr": "Ben de bir kahve istiyorum.", "note": "British konuşmada çok yaygın" }
  ]
}
