{
  "id": "core-phrases-reactions",
  "group": "core",
  "title": "Kalıplar 5: tepkiler, rica, nezaket",
  "level": "A2",
  "words": [
    { "en": "Oh, really?", "tr": "Öyle mi? Gerçekten mi?", "read": "ou [riı]-li", "type": "kalıp", "level": "A2", "example": "I'm moving to London. — Oh, really?", "exampleTr": "Londra'ya taşınıyorum. — Öyle mi?" },
    { "en": "No way!", "tr": "Olamaz! Yok artık!", "read": "nou [{w}ey]", "type": "kalıp", "level": "B1", "example": "I won the lottery! — No way!", "exampleTr": "Piyango çıktı! — Yok artık!" },
    { "en": "You're joking!", "tr": "Şaka yapıyorsun!", "read": "yoo [cou]-king", "type": "kalıp", "level": "B1", "example": "The flight is cancelled? You're joking!", "exampleTr": "Uçuş iptal mi? Şaka yapıyorsun!" },
    { "en": "That's great!", "tr": "Harika!", "read": "{d}{a}ts [greyt]", "type": "kalıp", "level": "A1", "example": "I got the job! — That's great!", "exampleTr": "İşi aldım! — Harika!" },
    { "en": "Well done!", "tr": "Aferin! Tebrikler!", "read": "{w}el [dan]", "type": "kalıp", "level": "A2", "example": "You passed? Well done!", "exampleTr": "Geçtin mi? Aferin!", "note": "British" },
    { "en": "Congratulations!", "tr": "Tebrikler!", "read": "kın-gr{a}-çu-[ley]-şınz", "type": "kalıp", "level": "A2", "example": "Congratulations on your new job!", "exampleTr": "Yeni işin için tebrikler!", "note": "congratulations on…" },
    { "en": "Good luck!", "tr": "Bol şans!", "read": "gud [lak]", "type": "kalıp", "level": "A1", "example": "Good luck with your interview!", "exampleTr": "Mülakatında bol şans!" },
    { "en": "Bless you", "tr": "Çok yaşa (hapşırınca)", "read": "[bles] yu", "type": "kalıp", "level": "B1", "example": "Atishoo! — Bless you!", "exampleTr": "Hapşu! — Çok yaşa!" },
    { "en": "What a shame", "tr": "Ne yazık", "read": "{w}ot ı [şeym]", "type": "kalıp", "level": "B1", "example": "You can't come? What a shame!", "exampleTr": "Gelemiyor musun? Ne yazık!" },
    { "en": "What a pity", "tr": "Ne yazık", "read": "{w}ot ı [pi]-ti", "type": "kalıp", "level": "B1", "example": "The concert was cancelled. What a pity!", "exampleTr": "Konser iptal oldu. Ne yazık!" },
    { "en": "Oh dear", "tr": "Eyvah, vah vah", "read": "ou [diı]", "type": "kalıp", "level": "B1", "example": "Oh dear, I've forgotten my keys.", "exampleTr": "Eyvah, anahtarlarımı unuttum.", "note": "British" },
    { "en": "I'm sorry to hear that", "tr": "Bunu duyduğuma üzüldüm", "read": "aym [so]-ri tı [hiı] {d}{a}t", "type": "kalıp", "level": "B1", "example": "My dad is in hospital. — I'm sorry to hear that.", "exampleTr": "Babam hastanede. — Buna üzüldüm." },
    { "en": "No problem", "tr": "Sorun değil", "read": "nou [prob]-lım", "type": "kalıp", "level": "A1", "example": "Thanks for your help! — No problem.", "exampleTr": "Yardımın için teşekkürler! — Sorun değil." },
    { "en": "No worries", "tr": "Dert etme, sorun değil", "read": "nou [{w}a]-riz", "type": "kalıp", "level": "B1", "example": "Sorry I'm late! — No worries.", "exampleTr": "Geç kaldığım için kusura bakma! — Dert etme." },
    { "en": "Don't mention it", "tr": "Lafı mı olur", "read": "dount [men]-şın it", "type": "kalıp", "level": "B1", "example": "Thanks a lot! — Don't mention it.", "exampleTr": "Çok teşekkürler! — Lafı mı olur." },
    { "en": "It doesn't matter", "tr": "Önemli değil", "read": "it [da]-zınt [m{a}]-tı", "type": "kalıp", "level": "A2", "example": "I broke your cup. — It doesn't matter.", "exampleTr": "Fincanını kırdım. — Önemli değil." },
    { "en": "Go ahead", "tr": "Buyur, devam et", "read": "gou ı-[hed]", "type": "kalıp", "level": "B1", "example": "Can I ask a question? — Go ahead.", "exampleTr": "Bir soru sorabilir miyim? — Buyur." },
    { "en": "After you", "tr": "Önce siz buyurun", "read": "[aaf]-tı yu", "type": "kalıp", "level": "B1", "example": "After you. — Oh, thank you.", "exampleTr": "Önce siz buyurun. — Ah, teşekkürler." },
    { "en": "Could you do me a favour?", "tr": "Bana bir iyilik yapar mısın?", "read": "kud yu duu mi ı [fey]-vı", "type": "kalıp", "level": "B1", "example": "Could you do me a favour and check this?", "exampleTr": "Bana bir iyilik yapıp şuna bakar mısın?", "note": "British yazım: favour" },
    { "en": "Do you mind if I…?", "tr": "… sakıncası var mı?", "read": "dı yu [maynd] if ay", "type": "kalıp", "level": "B1", "example": "Do you mind if I open the window?", "exampleTr": "Pencereyi açmamın sakıncası var mı?", "note": "Cevap: No, go ahead (= açabilirsin)" },
    { "en": "Is it OK if…?", "tr": "… olur mu?", "read": "iz it ou-[key] if", "type": "kalıp", "level": "A2", "example": "Is it OK if I leave early today?", "exampleTr": "Bugün erken çıksam olur mu?" },
    { "en": "I'd appreciate it", "tr": "Minnettar olurum", "read": "ayd ı-[prii]-şi-eyt it", "type": "kalıp", "level": "B2", "example": "If you could help, I'd really appreciate it.", "exampleTr": "Yardım edebilirsen gerçekten minnettar olurum." },
    { "en": "Thanks a lot", "tr": "Çok teşekkürler", "read": "{t}{a}nks ı [lot]", "type": "kalıp", "level": "A2", "example": "Thanks a lot for your help.", "exampleTr": "Yardımın için çok teşekkürler." },
    { "en": "Thanks anyway", "tr": "Yine de teşekkürler", "read": "{t}{a}nks [e]-ni-{w}ey", "type": "kalıp", "level": "B1", "example": "Sorry, I don't know. — Thanks anyway.", "exampleTr": "Kusura bakma, bilmiyorum. — Yine de teşekkürler." },
    { "en": "I owe you one", "tr": "Sana bir borcum var (iyilik)", "read": "ay [ou] yu {w}an", "type": "kalıp", "level": "B2", "example": "Thanks for covering for me. I owe you one.", "exampleTr": "Yerime baktığın için sağ ol. Sana borçluyum." },
    { "en": "Hang on a sec", "tr": "Bir saniye bekle", "read": "h{a}ng [on] ı [sek]", "type": "kalıp", "level": "B1", "example": "Hang on a sec, I'm just finishing an email.", "exampleTr": "Bir saniye, bir e-postayı bitiriyorum.", "note": "British, günlük" },
    { "en": "That's very kind of you", "tr": "Çok naziksiniz", "read": "{d}{a}ts [ve]-ri [kaynd] ıv yu", "type": "kalıp", "level": "B1", "example": "I'll drive you home. — That's very kind of you.", "exampleTr": "Seni eve bırakırım. — Çok naziksin." },
    { "en": "Fingers crossed", "tr": "İnşallah, şansımız yaver gider", "read": "[fin]-gız [krost]", "type": "kalıp", "level": "B1", "example": "I hope the release goes well. Fingers crossed!", "exampleTr": "Umarım sürüm iyi geçer. İnşallah!" },
    { "en": "Cheer up!", "tr": "Neşelen! Moralini bozma!", "read": "çiı [ap]", "type": "kalıp", "level": "B1", "example": "Cheer up! It's not that bad.", "exampleTr": "Moralini bozma! O kadar da kötü değil." },
    { "en": "Take it easy", "tr": "Sakin ol; kendini yorma", "read": "teyk it [ii]-zi", "type": "kalıp", "level": "B1", "example": "Take it easy this weekend.", "exampleTr": "Bu hafta sonu kendini yorma." }
  ]
}
