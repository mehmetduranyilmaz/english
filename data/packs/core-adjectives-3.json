{
  "id": "core-adjectives-3",
  "group": "core",
  "title": "Sıfatlar 3: duygular ve karakter",
  "level": "B1",
  "intro": "<p><b>Sahte arkadaşlara dikkat:</b> <b>sensible</b> «[sen]-sı-bıl» = mantıklı (hassas değil; hassas = sensitive). British İngilizcede <b>smart</b> genelde “şık” demektir.</p>",
  "words": [
    { "en": "pleased", "tr": "memnun", "read": "pliizd", "type": "sıfat", "level": "A2", "example": "I'm very pleased with the result.", "exampleTr": "Sonuçtan çok memnunum." },
    { "en": "glad", "tr": "memnun, sevinmiş", "read": "gl{a}d", "type": "sıfat", "level": "A2", "example": "I'm glad you came.", "exampleTr": "Gelmene sevindim." },
    { "en": "worried", "tr": "endişeli", "read": "[{w}a]-rid", "type": "sıfat", "level": "A2", "example": "I'm worried about the deadline.", "exampleTr": "Son teslim tarihi için endişeliyim." },
    { "en": "scared", "tr": "korkmuş", "read": "skeed", "type": "sıfat", "level": "A2", "example": "I'm scared of spiders.", "exampleTr": "Örümceklerden korkarım." },
    { "en": "afraid", "tr": "korkmuş; maalesef", "read": "ı-[freyd]", "type": "sıfat", "level": "A2", "example": "I'm afraid I can't come.", "exampleTr": "Maalesef gelemiyorum.", "note": "I'm afraid… = kibarca kötü haber vermek" },
    { "en": "annoyed", "tr": "sinirlenmiş, rahatsız", "read": "ı-[noyd]", "type": "sıfat", "level": "B1", "example": "I was annoyed with myself.", "exampleTr": "Kendime kızdım." },
    { "en": "confused", "tr": "kafası karışmış", "read": "kın-[fyuuzd]", "type": "sıfat", "level": "B1", "example": "I'm a bit confused.", "exampleTr": "Kafam biraz karıştı." },
    { "en": "curious", "tr": "meraklı", "read": "[kyuı]-ri-ıs", "type": "sıfat", "level": "B1", "example": "I'm just curious.", "exampleTr": "Sadece merak ettim." },
    { "en": "brave", "tr": "cesur", "read": "breyv", "type": "sıfat", "level": "B1", "example": "That was a brave decision.", "exampleTr": "Cesur bir karardı." },
    { "en": "lonely", "tr": "yalnız (hisseden)", "read": "[loun]-li", "type": "sıfat", "level": "B1", "example": "I felt lonely in a new city.", "exampleTr": "Yeni bir şehirde kendimi yalnız hissettim.", "note": "alone = tek başına; lonely = yalnızlık hisseden" },
    { "en": "positive", "tr": "olumlu", "read": "[po]-zı-tiv", "type": "sıfat", "level": "B1", "example": "Try to stay positive.", "exampleTr": "Olumlu kalmaya çalış.", "opposite": "negative" },
    { "en": "negative", "tr": "olumsuz", "read": "[ne]-gı-tiv", "type": "sıfat", "level": "B1", "example": "Don't be so negative.", "exampleTr": "Bu kadar olumsuz olma.", "opposite": "positive" },
    { "en": "sensitive", "tr": "hassas, duygusal", "read": "[sen]-sı-tiv", "type": "sıfat", "level": "B1", "example": "She's very sensitive.", "exampleTr": "Çok hassas biridir." },
    { "en": "sensible", "tr": "mantıklı, akıllıca", "read": "[sen]-sı-bıl", "type": "sıfat", "level": "B1", "example": "That's a sensible idea.", "exampleTr": "Mantıklı bir fikir.", "note": "Sahte arkadaş! hassas değil" },
    { "en": "smart", "tr": "şık; zeki", "read": "smaat", "type": "sıfat", "level": "B1", "example": "You look smart today.", "exampleTr": "Bugün çok şıksın.", "note": "British: genelde “şık”" },
    { "en": "stupid", "tr": "aptal", "read": "[styuu]-pid", "type": "sıfat", "level": "A2", "example": "It was a stupid mistake.", "exampleTr": "Aptalca bir hataydı." },
    { "en": "silly", "tr": "saçma, aptalca (hafif)", "read": "[si]-li", "type": "sıfat", "level": "B1", "example": "Don't be silly!", "exampleTr": "Saçmalama!" },
    { "en": "crazy", "tr": "çılgın, deli", "read": "[krey]-zi", "type": "sıfat", "level": "A2", "example": "That's crazy!", "exampleTr": "Bu çılgınca!" },
    { "en": "ambitious", "tr": "hırslı", "read": "{a}m-[bi]-şıs", "type": "sıfat", "level": "B1", "example": "She's very ambitious.", "exampleTr": "Çok hırslıdır." },
    { "en": "creative", "tr": "yaratıcı", "read": "kri-[ey]-tiv", "type": "sıfat", "level": "B1", "example": "We need a creative solution.", "exampleTr": "Yaratıcı bir çözüme ihtiyacımız var." },
    { "en": "independent", "tr": "bağımsız", "read": "in-di-[pen]-dınt", "type": "sıfat", "level": "B1", "example": "I like working independently.", "exampleTr": "Bağımsız çalışmayı severim." },
    { "en": "mature", "tr": "olgun", "read": "mı-[çuı]", "type": "sıfat", "level": "B2", "example": "He's very mature for his age.", "exampleTr": "Yaşına göre çok olgun." },
    { "en": "sociable", "tr": "sosyal, girişken", "read": "[sou]-şı-bıl", "type": "sıfat", "level": "B1", "example": "I'm quite sociable.", "exampleTr": "Oldukça girişkenim." },
    { "en": "talkative", "tr": "konuşkan", "read": "[too]-kı-tiv", "type": "sıfat", "level": "B1", "example": "She's very talkative.", "exampleTr": "Çok konuşkan." },
    { "en": "easy-going", "tr": "rahat, uysal", "read": "ii-zi-[gou]-ing", "type": "sıfat", "level": "B1", "example": "My boss is very easy-going.", "exampleTr": "Patronum çok rahat biri." },
    { "en": "moody", "tr": "huysuz, dengesiz", "read": "[muu]-di", "type": "sıfat", "level": "B2", "example": "Teenagers can be moody.", "exampleTr": "Gençler huysuz olabilir." },
    { "en": "excellent", "tr": "mükemmel", "read": "[ek]-sı-lınt", "type": "sıfat", "level": "A2", "example": "Excellent work!", "exampleTr": "Mükemmel iş!" },
    { "en": "fine (iyi)", "ref": "fine" },
    { "en": "proud", "ref": "proud" },
    { "en": "nervous", "ref": "nervous" }
  ]
}
