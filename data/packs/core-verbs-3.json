    { "en": "remain", "tr": "kalmak (resmi)", "read": "ri-[meyn]", "type": "fiil", "level": "B1", "example": "Please remain seated.", "exampleTr": "Lütfen oturmaya devam edin." },
    { "en": "respond", "tr": "yanıt vermek", "read": "ri-[spond]", "type": "fiil", "level": "B1", "example": "She hasn't responded to my email.", "exampleTr": "E-postama yanıt vermedi." },
