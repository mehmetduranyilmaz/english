    { "en": "complete", "tr": "tamamlamak; tam, eksiksiz", "read": "kım-[pliit]", "type": "fiil", "level": "B1", "example": "Please complete the form.", "exampleTr": "Lütfen formu doldurun." },
    { "en": "contain", "tr": "içermek", "read": "kın-[teyn]", "type": "fiil", "level": "B1", "example": "This drink contains sugar.", "exampleTr": "Bu içecek şeker içeriyor." },
    { "en": "count", "tr": "saymak", "read": "kaunt", "type": "fiil", "level": "A2", "example": "Count to ten.", "exampleTr": "Ona kadar say." },
    { "en": "gain", "tr": "kazanmak, edinmek", "read": "geyn", "type": "fiil", "level": "B1", "example": "I gained a lot of experience.", "exampleTr": "Çok deneyim kazandım." },
    { "en": "ignore", "tr": "görmezden gelmek", "read": "ig-[noo]", "type": "fiil", "level": "B1", "example": "Just ignore the warning.", "exampleTr": "Uyarıyı görmezden gel." },
    { "en": "judge", "tr": "yargılamak; hâkim", "read": "cac", "type": "fiil", "level": "B1", "example": "Don't judge people by their looks.", "exampleTr": "İnsanları görünüşlerine göre yargılama." },
    { "en": "lack", "tr": "eksikliği olmak; eksiklik", "read": "l{a}k", "type": "fiil", "level": "B2", "example": "The team lacks experience.", "exampleTr": "Takımın deneyimi eksik." },
    { "en": "point out", "tr": "belirtmek, dikkat çekmek", "read": "poynt [aut]", "type": "fiil", "level": "B1", "example": "She pointed out a mistake.", "exampleTr": "Bir hatayı belirtti." },
    { "en": "react", "tr": "tepki vermek", "read": "ri-[{a}kt]", "type": "fiil", "level": "B1", "example": "How did he react?", "exampleTr": "Nasıl tepki verdi?" }
  ]
