    { "en": "avoid", "tr": "kaçınmak", "read": "ı-[voyd]", "type": "fiil", "level": "B1", "example": "Try to avoid the motorway at rush hour.", "exampleTr": "Yoğun saatte otoyoldan kaçınmaya çalış.", "note": "avoid + -ing" },
    { "en": "belong", "tr": "ait olmak", "read": "bi-[long]", "type": "fiil", "level": "B1", "example": "This bag belongs to me.", "exampleTr": "Bu çanta bana ait." },
    { "en": "deserve", "tr": "hak etmek", "read": "di-[zööv]", "type": "fiil", "level": "B2", "example": "You deserve a holiday.", "exampleTr": "Bir tatili hak ediyorsun." },
    { "en": "encourage", "tr": "cesaretlendirmek, teşvik etmek", "read": "in-[ka]-ric", "type": "fiil", "level": "B1", "example": "My teacher encouraged me to keep going.", "exampleTr": "Öğretmenim devam etmem için beni cesaretlendirdi." },
