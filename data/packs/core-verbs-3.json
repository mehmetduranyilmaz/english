    { "en": "recommend", "tr": "tavsiye etmek", "read": "re-kı-[mend]", "type": "fiil", "level": "B1", "example": "Can you recommend a good restaurant?", "exampleTr": "İyi bir restoran tavsiye edebilir misin?" },
