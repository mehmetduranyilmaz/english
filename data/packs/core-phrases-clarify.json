{
  "id": "core-phrases-clarify",
  "group": "core",
  "title": "Kalıplar 2: anlamadığınızda",
  "level": "A2",
  "intro": "<p>Anlamamak sorun değil; sessiz kalmak sorun. Bu kalıplarla karşınızdakini kibarca yavaşlatın, tekrarlatın veya netleştirin. İngilizler bunu sizden bekler.</p>",
  "words": [
    { "en": "Sorry, I didn't catch that", "tr": "Pardon, tam anlayamadım", "read": "[so]-ri ay di-dınt [k{a}ç] {d}{a}t", "type": "kalıp", "level": "B1", "example": "Sorry, I didn't catch that. Could you say it again?", "exampleTr": "Pardon, tam anlayamadım. Tekrar söyler misin?", "note": "British: çok kibar ve doğal" },
    { "en": "Could you say that again?", "tr": "Tekrar söyler misiniz?", "read": "kud yu [sey] {d}{a}t ı-[gen]", "type": "kalıp", "level": "A2", "example": "Could you say that again, please?", "exampleTr": "Tekrar söyler misiniz, lütfen?", "note": "British: again “ı-GEN”" },
    { "en": "Pardon?", "tr": "Efendim? Anlamadım", "read": "[paa]-dın", "type": "kalıp", "level": "A2", "example": "Pardon? I couldn't hear you.", "exampleTr": "Efendim? Sizi duyamadım.", "note": "British; “What?” kaba kaçabilir" },
    { "en": "What do you mean?", "tr": "Ne demek istiyorsun?", "read": "{w}ot dı yu [miin]", "type": "kalıp", "level": "A2", "example": "What do you mean by “soon”?", "exampleTr": "“Yakında” derken neyi kastediyorsun?" },
    { "en": "What does it mean?", "tr": "Ne anlama geliyor?", "read": "{w}ot daz it [miin]", "type": "kalıp", "level": "A2", "example": "“Knackered”? What does it mean?", "exampleTr": "“Knackered” mı? Ne anlama geliyor?" },
    { "en": "How do you spell that?", "tr": "Nasıl yazılıyor?", "read": "hau dı yu [spel] {d}{a}t", "type": "kalıp", "level": "A2", "example": "Your surname? How do you spell that?", "exampleTr": "Soyadınız mı? Nasıl yazılıyor?" },
    { "en": "Do you mean…?", "tr": "… mı demek istiyorsun?", "read": "dı yu [miin]", "type": "kalıp", "level": "B1", "example": "Do you mean next Monday or this Monday?", "exampleTr": "Gelecek pazartesiyi mi bu pazartesiyi mi kastediyorsun?" },
    { "en": "So you're saying…", "tr": "Yani diyorsun ki…", "read": "sou yoo [sey]-ing", "type": "kalıp", "level": "B1", "example": "So you're saying it's not possible?", "exampleTr": "Yani mümkün değil mi diyorsun?" },
    { "en": "Let me get this straight", "tr": "Bir de şöyle netleştireyim", "read": "let mi get {d}is [streyt]", "type": "kalıp", "level": "B2", "example": "Let me get this straight: you want it by tomorrow?", "exampleTr": "Netleştireyim: yarına kadar mı istiyorsun?" },
    { "en": "If I understand correctly", "tr": "Doğru anladıysam", "read": "if ay an-dı-[st{a}nd] kı-[rekt]-li", "type": "kalıp", "level": "B1", "example": "If I understand correctly, the meeting is cancelled.", "exampleTr": "Doğru anladıysam toplantı iptal." },
    { "en": "Does that make sense?", "tr": "Anlaşılır mı? Mantıklı mı?", "read": "daz {d}{a}t meyk [sens]", "type": "kalıp", "level": "B1", "example": "We'll test it first. Does that make sense?", "exampleTr": "Önce test edeceğiz. Anlaşılır mı?" },
    { "en": "That makes sense", "tr": "Mantıklı, anlaşıldı", "read": "{d}{a}t meyks [sens]", "type": "kalıp", "level": "B1", "example": "Oh, that makes sense now.", "exampleTr": "Ha, şimdi anlaşıldı." },
    { "en": "I see", "tr": "Anlıyorum", "read": "ay [sii]", "type": "kalıp", "level": "A2", "example": "I see. Thanks for explaining.", "exampleTr": "Anlıyorum. Açıkladığın için teşekkürler." },
    { "en": "I'm not sure I follow", "tr": "Takip edebildiğimden emin değilim", "read": "aym not [şoo] ay [fo]-lou", "type": "kalıp", "level": "B2", "example": "Sorry, I'm not sure I follow.", "exampleTr": "Pardon, seni takip edebildiğimden emin değilim." },
    { "en": "I'm not with you", "tr": "Seni anlayamadım", "read": "aym not [{w}i{d}] yu", "type": "kalıp", "level": "B2", "example": "Sorry, I'm not with you. Which file?", "exampleTr": "Pardon, anlayamadım. Hangi dosya?", "note": "British" },
    { "en": "Just to clarify", "tr": "Netleştirmek için", "read": "cast tı [kl{a}]-rı-fay", "type": "kalıp", "level": "B2", "example": "Just to clarify, is it today or tomorrow?", "exampleTr": "Netleştirmek için soruyorum: bugün mü yarın mı?" },
    { "en": "Is that right?", "tr": "Doğru mu?", "read": "iz {d}{a}t [rayt]", "type": "kalıp", "level": "A2", "example": "You start at nine. Is that right?", "exampleTr": "Dokuzda başlıyorsun. Doğru mu?" },
    { "en": "Got it", "tr": "Anladım, tamam", "read": "[got] it", "type": "kalıp", "level": "B1", "example": "Turn left at the lights? Got it.", "exampleTr": "Işıklarda sola mı? Anladım." },
    { "en": "Fair enough", "tr": "Makul, olur", "read": "fee-ri-[naf]", "type": "kalıp", "level": "B1", "example": "You're busy today? Fair enough.", "exampleTr": "Bugün meşgul müsün? Olur, anlarım.", "note": "British: bağlayan r ile “fee-ri-naf”" },
    { "en": "Could you repeat the question?", "tr": "Soruyu tekrarlar mısınız?", "read": "kud yu ri-[piit] {d}ı [k{w}es]-çın", "type": "kalıp", "level": "B1", "example": "Sorry, could you repeat the question?", "exampleTr": "Pardon, soruyu tekrarlar mısınız?" },
    { "en": "Can you give me an example?", "tr": "Bir örnek verebilir misin?", "read": "kın yu giv mi ın ig-[zaam]-pıl", "type": "kalıp", "level": "B1", "example": "I don't understand. Can you give me an example?", "exampleTr": "Anlamadım. Bir örnek verebilir misin?" },
    { "en": "Can you write it down?", "tr": "Yazabilir misin?", "read": "kın yu rayt it [daun]", "type": "kalıp", "level": "A2", "example": "Can you write it down for me?", "exampleTr": "Benim için yazabilir misin?" },
    { "en": "Hang on, let me check", "tr": "Bir saniye, kontrol edeyim", "read": "h{a}ng [on] let mi [çek]", "type": "kalıp", "level": "B1", "example": "Hang on, let me check my calendar.", "exampleTr": "Bir saniye, takvimime bakayım." },
    { "en": "Bear with me", "tr": "Bir saniye sabredin", "read": "[bee] {w}i{d} mi", "type": "kalıp", "level": "B2", "example": "Bear with me, the file is loading.", "exampleTr": "Bir saniye, dosya yükleniyor.", "note": "British iş dilinde çok yaygın" },
    { "en": "What was that?", "tr": "Ne dedin?", "read": "{w}ot [{w}oz] {d}{a}t", "type": "kalıp", "level": "A2", "example": "What was that? The music is too loud.", "exampleTr": "Ne dedin? Müzik çok yüksek." }
  ]
}
