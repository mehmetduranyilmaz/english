    { "en": "approve", "tr": "onaylamak", "read": "ı-[pruuv]", "type": "fiil", "level": "B1", "example": "Two people need to approve it.", "exampleTr": "İki kişinin onaylaması gerekiyor." },
    { "en": "request changes", "tr": "değişiklik istemek", "read": "ri-[k{w}est] [çeyn]-ciz", "type": "kalıp", "level": "B2", "example": "She requested some changes.", "exampleTr": "Bazı değişiklikler istedi." },
    { "en": "feedback", "tr": "geri bildirim", "read": "[fiid]-b{a}k", "type": "isim", "level": "B1", "example": "Thanks for the feedback.", "exampleTr": "Geri bildirim için teşekkürler.", "note": "sayılamaz: ✘ a feedback" },
    { "en": "refactor", "tr": "yeniden düzenlemek (kod)", "read": "rii-[f{a}k]-tı", "type": "fiil", "level": "B2", "example": "We should refactor this function.", "exampleTr": "Bu fonksiyonu yeniden düzenlemeliyiz." },
    { "en": "clean code", "tr": "temiz kod", "read": "kliin [koud]", "type": "isim", "level": "B1", "example": "Clean code is easier to maintain.", "exampleTr": "Temiz kodun bakımı daha kolaydır." },
    { "en": "readable", "tr": "okunabilir", "read": "[rii]-dı-bıl", "type": "sıfat", "level": "B1", "example": "Make the code more readable.", "exampleTr": "Kodu daha okunabilir yap." },
    { "en": "naming", "tr": "isimlendirme", "read": "[ney]-ming", "type": "isim", "level": "B1", "example": "Naming is the hardest part.", "exampleTr": "En zor kısım isimlendirme." },
    { "en": "rename", "tr": "yeniden adlandırmak", "read": "rii-[neym]", "type": "fiil", "level": "B1", "example": "Can you rename this variable?", "exampleTr": "Bu değişkeni yeniden adlandırabilir misin?" },
    { "en": "revert", "tr": "geri almak", "read": "ri-[vööt]", "type": "fiil", "level": "B2", "example": "Let's revert the last commit.", "exampleTr": "Son commit'i geri alalım." },
    { "en": "roll back", "tr": "önceki sürüme dönmek", "read": "roul [b{a}k]", "type": "fiil", "level": "B2", "example": "We had to roll back the release.", "exampleTr": "Sürümü geri almak zorunda kaldık." },
    { "en": "rebase", "tr": "rebase etmek", "read": "rii-[beys]", "type": "fiil", "level": "B2", "example": "Please rebase on main.", "exampleTr": "Lütfen main üzerine rebase et." },
    { "en": "main branch", "tr": "ana dal", "read": "meyn [braanç]", "type": "isim", "level": "B1", "example": "Never push directly to the main branch.", "exampleTr": "Ana dala asla doğrudan push etme." },
    { "en": "feature branch", "tr": "özellik dalı", "read": "[fii]-çı braanç", "type": "isim", "level": "B1", "example": "Create a feature branch for this.", "exampleTr": "Bunun için bir özellik dalı oluştur." },
    { "en": "diff", "tr": "fark (kod)", "read": "dif", "type": "isim", "level": "B2", "example": "The diff is quite small.", "exampleTr": "Fark oldukça küçük." },
    { "en": "changelog", "tr": "değişiklik günlüğü", "read": "[çeync]-log", "type": "isim", "level": "B2", "example": "Update the changelog before the release.", "exampleTr": "Sürümden önce değişiklik günlüğünü güncelle." },
    { "en": "nitpick", "tr": "kılı kırk yaran küçük yorum", "read": "[nit]-pik", "type": "isim", "level": "B2", "example": "Just a nitpick: add a space here.", "exampleTr": "Ufak bir not: buraya boşluk ekle.", "note": "PR yorumlarında kısaca: nit" },
    { "en": "LGTM", "tr": "bana uygun görünüyor (onay)", "read": "el cii tii [em]", "type": "kalıp", "level": "B2", "example": "LGTM, merging now.", "exampleTr": "Bence uygun, şimdi birleştiriyorum.", "note": "Looks good to me" }
  ]
