    { "en": "commit", "tr": "commit; kaydetmek", "read": "kı-[mit]", "type": "fiil", "level": "B1", "example": "Don't forget to commit your changes.", "exampleTr": "Değişikliklerini commit'lemeyi unutma." },
    { "en": "push", "ref": "push" },
    { "en": "pull", "ref": "pull" },
