    { "en": "merge conflict", "tr": "birleştirme çakışması", "read": "[mööc] [kon]-flikt", "type": "isim", "level": "B2", "example": "I've got a merge conflict.", "exampleTr": "Birleştirme çakışması çıktı." },
    { "en": "conflict", "tr": "çakışma, anlaşmazlık", "read": "[kon]-flikt", "type": "isim", "level": "B1", "example": "We need to resolve the conflict.", "exampleTr": "Çakışmayı çözmemiz lazım." },
    { "en": "resolve", "tr": "çözmek, gidermek", "read": "ri-[zolv]", "type": "fiil", "level": "B2", "example": "I've resolved the issue.", "exampleTr": "Sorunu giderdim." },
    { "en": "pull request", "tr": "birleştirme isteği (PR)", "read": "[pul] ri-k{w}est", "type": "isim", "level": "B1", "example": "I've opened a pull request.", "exampleTr": "Bir pull request açtım.", "note": "kısaca: PR «pii [aa]»" },
    { "en": "code review", "tr": "kod incelemesi", "read": "[koud] ri-vyuu", "type": "isim", "level": "B1", "example": "Can you do a code review for me?", "exampleTr": "Benim için kod incelemesi yapabilir misin?" },
