{
  "id": "dev-process",
  "group": "dev",
  "title": "Yazılım 2: süreç, agile, sprint",
  "level": "B1",
  "words": [
    { "en": "agile", "tr": "çevik (agile)", "read": "[{a}]-cayl", "type": "sıfat", "level": "B1", "example": "We follow an agile process.", "exampleTr": "Çevik bir süreç izliyoruz.", "note": "British: “A-cayl”; Amerikan: “A-cıl”" },
    { "en": "sprint", "tr": "sprint (iş döngüsü)", "read": "sprint", "type": "isim", "level": "B1", "example": "Our sprints are two weeks long.", "exampleTr": "Sprintlerimiz iki hafta sürüyor." },
    { "en": "backlog", "tr": "iş listesi, birikmiş işler", "read": "[b{a}k]-log", "type": "isim", "level": "B1", "example": "Add it to the backlog.", "exampleTr": "İş listesine ekle." },
    { "en": "ticket", "ref": "ticket" },
    { "en": "user story", "tr": "kullanıcı hikâyesi", "read": "[yuu]-zı [stoo]-ri", "type": "isim", "level": "B1", "example": "Write it as a user story.", "exampleTr": "Kullanıcı hikâyesi olarak yaz." },
    { "en": "estimate", "tr": "tahmin etmek; tahmin", "read": "[es]-ti-meyt", "type": "fiil", "level": "B1", "example": "Can you estimate how long it will take?", "exampleTr": "Ne kadar süreceğini tahmin edebilir misin?", "note": "isim olarak: “ES-ti-mıt”" },
    { "en": "priority", "tr": "öncelik", "read": "pray-[o]-rı-ti", "type": "isim", "level": "B1", "example": "This bug is a top priority.", "exampleTr": "Bu hata en öncelikli iş." },
    { "en": "stand-up", "tr": "günlük kısa toplantı", "read": "[st{a}nd]-ap", "type": "isim", "level": "B1", "example": "See you at stand-up.", "exampleTr": "Kısa toplantıda görüşürüz." },
    { "en": "retrospective", "tr": "retrospektif (geriye dönük değerlendirme)", "read": "re-trı-[spek]-tiv", "type": "isim", "level": "B2", "example": "We discussed it in the retrospective.", "exampleTr": "Bunu retrospektifte konuştuk.", "note": "kısaca: retro" },
    { "en": "planning", "tr": "planlama", "read": "[pl{a}]-ning", "type": "isim", "level": "B1", "example": "Sprint planning is on Monday.", "exampleTr": "Sprint planlaması pazartesi." },
    { "en": "milestone", "tr": "kilometre taşı", "read": "[mayl]-stoun", "type": "isim", "level": "B2", "example": "We've reached an important milestone.", "exampleTr": "Önemli bir kilometre taşına ulaştık." },
    { "en": "scope", "tr": "kapsam", "read": "skoup", "type": "isim", "level": "B2", "example": "That's outside the scope of this project.", "exampleTr": "Bu, projenin kapsamı dışında." },
    { "en": "roadmap", "tr": "yol haritası", "read": "[roud]-m{a}p", "type": "isim", "level": "B1", "example": "It's on the roadmap for next year.", "exampleTr": "Gelecek yılın yol haritasında var." },
    { "en": "stakeholder", "tr": "paydaş", "read": "[steyk]-houl-dı", "type": "isim", "level": "B2", "example": "We need to update the stakeholders.", "exampleTr": "Paydaşları bilgilendirmemiz lazım." },
    { "en": "product owner", "tr": "ürün sahibi", "read": "[pro]-dakt [ou]-nı", "type": "isim", "level": "B1", "example": "Ask the product owner.", "exampleTr": "Ürün sahibine sor." },
    { "en": "blocker", "tr": "engel", "read": "[blo]-kı", "type": "isim", "level": "B1", "example": "Do you have any blockers?", "exampleTr": "Seni engelleyen bir şey var mı?" },
    { "en": "dependency", "tr": "bağımlılık", "read": "di-[pen]-dın-si", "type": "isim", "level": "B2", "example": "We need to update the dependencies.", "exampleTr": "Bağımlılıkları güncellememiz lazım." },
    { "en": "workload", "tr": "iş yükü", "read": "[{w}öök]-loud", "type": "isim", "level": "B1", "example": "My workload is too heavy this week.", "exampleTr": "Bu hafta iş yüküm çok ağır." },
    { "en": "capacity", "tr": "kapasite", "read": "kı-[p{a}]-sı-ti", "type": "isim", "level": "B2", "example": "We don't have the capacity for this.", "exampleTr": "Buna kapasitemiz yok." },
    { "en": "on track", "tr": "yolunda, planlandığı gibi", "read": "on [tr{a}k]", "type": "kalıp", "level": "B1", "example": "The project is on track.", "exampleTr": "Proje planlandığı gibi gidiyor." },
    { "en": "behind schedule", "tr": "programın gerisinde", "read": "bi-[haynd] [şe]-dyuul", "type": "kalıp", "level": "B1", "example": "We're two weeks behind schedule.", "exampleTr": "Programın iki hafta gerisindeyiz.", "opposite": "ahead of schedule" },
    { "en": "ahead of schedule", "tr": "programın önünde", "read": "ı-[hed] ıv [şe]-dyuul", "type": "kalıp", "level": "B2", "example": "Surprisingly, we're ahead of schedule.", "exampleTr": "Şaşırtıcı şekilde programın önündeyiz.", "opposite": "behind schedule" },
    { "en": "kick-off", "tr": "başlangıç toplantısı", "read": "[kik]-of", "type": "isim", "level": "B2", "example": "The project kick-off is next week.", "exampleTr": "Proje başlangıç toplantısı gelecek hafta." },
    { "en": "hand over", "tr": "devretmek", "read": "h{a}nd [ou]-vı", "type": "fiil", "level": "B2", "example": "I'll hand it over to Tom before my holiday.", "exampleTr": "Tatilden önce Tom'a devredeceğim." },
    { "en": "ship", "ref": "ship" },
    { "en": "iterate", "tr": "yinelemek, adım adım geliştirmek", "read": "[i]-tı-reyt", "type": "fiil", "level": "B2", "example": "Let's ship it and iterate.", "exampleTr": "Yayınlayalım, sonra adım adım geliştiririz." },
    { "en": "prototype", "tr": "prototip", "read": "[prou]-tı-tayp", "type": "isim", "level": "B1", "example": "We built a quick prototype.", "exampleTr": "Hızlı bir prototip yaptık." },
    { "en": "MVP", "tr": "minimum uygulanabilir ürün", "read": "em vii [pii]", "type": "isim", "level": "B2", "example": "Let's focus on the MVP first.", "exampleTr": "Önce MVP'ye odaklanalım." },
    { "en": "deliverable", "tr": "teslim edilecek iş", "read": "di-[li]-vı-rı-bıl", "type": "isim", "level": "B2", "example": "What are the deliverables for this sprint?", "exampleTr": "Bu sprintte neler teslim edilecek?" }
  ]
}
