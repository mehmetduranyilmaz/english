{
  "id": "core-health-doctor",
  "group": "core",
  "title": "Sağlık 2: doktorda ve eczanede şikâyet anlatma",
  "level": "B1",
  "intro": "<p><b>Şikâyet anlatma sırası:</b> ne oluyor → ne zamandır → ne zaman kötüleşiyor → ne yaptınız. Örnek: <i>“I've had a bad cough <b>for</b> a week. It gets worse <b>at night</b>. I've tried cough syrup, but it didn't help.”</i> Süre için Present Perfect kullanın (18. aşama): I've had… for / since… <b>British:</b> Önce aile hekimine (GP) randevu alınır; acil durumda A&E, ambulans için 999.</p>",
  "words": [
    { "en": "I'd like to see a doctor", "tr": "Doktora görünmek istiyorum", "read": "ayd [layk] tı sii ı [dok]-tı", "type": "kalıp", "level": "A2", "example": "Hello, I'd like to see a doctor, please.", "exampleTr": "Merhaba, doktora görünmek istiyorum, lütfen." },
    { "en": "What seems to be the problem?", "tr": "Sorun nedir? (doktorun sorusu)", "read": "{w}ot [siimz] tı bi {d}ı [prob]-lım", "type": "kalıp", "level": "B1", "example": "Come in, sit down. What seems to be the problem?", "exampleTr": "Gelin, oturun. Sorununuz nedir?" },
    { "en": "I've been feeling unwell", "tr": "Bir süredir kendimi iyi hissetmiyorum", "read": "ayv biin [fii]-ling an-[{w}el]", "type": "kalıp", "level": "B1", "example": "I've been feeling unwell for a few days.", "exampleTr": "Birkaç gündür kendimi iyi hissetmiyorum." },
    { "en": "I've had … since …", "tr": "…'den beri … var", "read": "ayv [h{a}d] … sins", "type": "kalıp", "level": "B1", "example": "I've had a headache since yesterday morning.", "exampleTr": "Dün sabahtan beri başım ağrıyor." },
    { "en": "It hurts here", "tr": "Şuram ağrıyor", "read": "it [hööts] hiı", "type": "kalıp", "level": "A2", "example": "It hurts here, on the left side.", "exampleTr": "Şuram ağrıyor, sol tarafta." },
    { "en": "It hurts when I…", "tr": "… yapınca ağrıyor", "read": "it [hööts] {w}en ay", "type": "kalıp", "level": "B1", "example": "It hurts when I swallow.", "exampleTr": "Yutkununca ağrıyor." },
    { "en": "The pain comes and goes", "tr": "Ağrı gelip gidiyor", "read": "{d}ı [peyn] kamz ın [gouz]", "type": "kalıp", "level": "B2", "example": "The pain comes and goes, but it's worse at night.", "exampleTr": "Ağrı gelip gidiyor ama gece daha kötü." },
    { "en": "It's getting worse", "tr": "Gittikçe kötüleşiyor", "read": "its [ge]-ting [{w}öös]", "type": "kalıp", "level": "B1", "example": "My cough is getting worse.", "exampleTr": "Öksürüğüm gittikçe kötüleşiyor." },
    { "en": "I can't stop coughing", "tr": "Öksürüğüm durmuyor", "read": "ay [kaant] stop [ko]-fing", "type": "kalıp", "level": "B1", "example": "I can't stop coughing at night.", "exampleTr": "Gece öksürüğüm durmuyor." },
    { "en": "I've lost my appetite", "tr": "İştahım kesildi", "read": "ayv lost may [{a}]-pı-tayt", "type": "kalıp", "level": "B2", "example": "I feel weak and I've lost my appetite.", "exampleTr": "Halsizim ve iştahım kesildi." },
    { "en": "I'm allergic to…", "tr": "…'e alerjim var", "read": "aym ı-[löö]-cik tuu", "type": "kalıp", "level": "B1", "example": "I'm allergic to penicillin.", "exampleTr": "Penisiline alerjim var." },
    { "en": "I'm taking … at the moment", "tr": "Şu an … kullanıyorum", "read": "aym [tey]-king … ıt {d}ı [mou]-mınt", "type": "kalıp", "level": "B1", "example": "I'm taking medicine for blood pressure at the moment.", "exampleTr": "Şu an tansiyon ilacı kullanıyorum." },
    { "en": "Is it serious?", "tr": "Ciddi mi?", "read": "iz it [siı]-ri-ıs", "type": "kalıp", "level": "A2", "example": "Is it serious, doctor?", "exampleTr": "Ciddi mi, doktor bey?" },
    { "en": "How often should I take it?", "tr": "Ne sıklıkla almalıyım?", "read": "hau [o]-fın şud ay [teyk] it", "type": "kalıp", "level": "B1", "example": "How often should I take it?", "exampleTr": "Ne sıklıkla almalıyım?" },
    { "en": "three times a day", "tr": "günde üç kez", "read": "{t}rii [taymz] ı dey", "type": "kalıp", "level": "A2", "example": "Take one tablet three times a day.", "exampleTr": "Günde üç kez birer tablet alın." },
    { "en": "after meals", "tr": "yemeklerden sonra", "read": "[aaf]-tı miilz", "type": "kalıp", "level": "B1", "example": "Take it after meals.", "exampleTr": "Yemeklerden sonra alın.", "opposite": "on an empty stomach" },
    { "en": "on an empty stomach", "tr": "aç karnına", "read": "on ın [emp]-ti [sta]-mık", "type": "kalıp", "level": "B2", "example": "Don't take this on an empty stomach.", "exampleTr": "Bunu aç karnına almayın.", "opposite": "after meals" },
    { "en": "Are there any side effects?", "tr": "Yan etkisi var mı?", "read": "aa {d}ee e-ni [sayd] i-fekts", "type": "kalıp", "level": "B1", "example": "Are there any side effects?", "exampleTr": "Yan etkisi var mı?" },
    { "en": "Have you got anything for…?", "tr": "… için bir şeyiniz var mı? (eczanede)", "read": "h{a}v yu got [e]-ni-{t}ing foo", "type": "kalıp", "level": "B1", "example": "Have you got anything for a sore throat?", "exampleTr": "Boğaz ağrısı için bir şeyiniz var mı?" },
    { "en": "Do I need a prescription?", "tr": "Reçete gerekiyor mu?", "read": "duu ay niid ı pri-[skrip]-şın", "type": "kalıp", "level": "B1", "example": "Do I need a prescription for this?", "exampleTr": "Bunun için reçete gerekiyor mu?" },
    { "en": "Can I have a sick note?", "tr": "Rapor alabilir miyim? (işe)", "read": "kın ay h{a}v ı [sik] nout", "type": "kalıp", "level": "B2", "example": "Can I have a sick note for work?", "exampleTr": "İş için rapor alabilir miyim?", "note": "British; resmi adı: fit note" },
    { "en": "Get well soon!", "tr": "Geçmiş olsun!", "read": "get [{w}el] suun", "type": "kalıp", "level": "A2", "example": "I heard you're ill. Get well soon!", "exampleTr": "Hasta olduğunu duydum. Geçmiş olsun!" },
    { "en": "tablet", "tr": "tablet (ilaç)", "read": "[t{a}b]-lıt", "type": "isim", "level": "B1", "example": "Take two tablets with water.", "exampleTr": "Suyla iki tablet alın." },
    { "en": "painkiller", "tr": "ağrı kesici", "read": "[peyn]-ki-lı", "type": "isim", "level": "B1", "example": "Have you taken a painkiller?", "exampleTr": "Ağrı kesici aldın mı?" },
    { "en": "antibiotics", "tr": "antibiyotik", "read": "{a}n-ti-bay-[o]-tiks", "type": "isim", "level": "B2", "example": "You don't need antibiotics for a cold.", "exampleTr": "Soğuk algınlığı için antibiyotik gerekmez." },
    { "en": "side effect", "tr": "yan etki", "read": "[sayd] i-fekt", "type": "isim", "level": "B1", "example": "One side effect is feeling sleepy.", "exampleTr": "Yan etkilerden biri uyku hali." },
    { "en": "check-up", "tr": "check-up, genel kontrol", "read": "[çek]-ap", "type": "isim", "level": "B1", "example": "I go for a check-up every year.", "exampleTr": "Her yıl genel kontrole giderim." },
    { "en": "X-ray", "tr": "röntgen", "read": "[eks]-rey", "type": "isim", "level": "B1", "example": "We need to do an X-ray.", "exampleTr": "Röntgen çekmemiz lazım." },
    { "en": "jab", "tr": "aşı, iğne (günlük)", "read": "c{a}b", "type": "isim", "level": "B2", "example": "Have you had your flu jab?", "exampleTr": "Grip aşını oldun mu?", "note": "British; resmi: vaccine «[v{a}k]-siin»" },
    { "en": "plaster", "tr": "yara bandı; alçı", "read": "[plaas]-tı", "type": "isim", "level": "B1", "example": "Have you got a plaster? I've cut my finger.", "exampleTr": "Yara bandın var mı? Parmağımı kestim.", "note": "British; Amerikan: band-aid" },
    { "en": "pharmacist", "tr": "eczacı", "read": "[faa]-mı-sist", "type": "isim", "level": "B1", "example": "Ask the pharmacist for advice.", "exampleTr": "Eczacıya danışın." },
    { "en": "appointment", "ref": "appointment" },
    { "en": "GP", "ref": "gp" },
    { "en": "chemist's", "ref": "chemist's" },
    { "en": "prescription", "ref": "prescription" }
  ]
}
