{
  "id": "dev-writing",
  "group": "dev",
  "title": "Yazılım 10: Slack ve e-posta",
  "level": "B1",
  "intro": "<p>İş yazışmasında kısa, kibar ve net olun. İngilizler doğrudan emir yerine “Could you…?” der ve “Thanks!” eksik etmez.</p>",
  "words": [
    { "en": "Quick question", "tr": "Kısa bir sorum var", "read": "k{w}ik [k{w}es]-çın", "type": "kalıp", "level": "B1", "example": "Hi Tom, quick question: is the API down?", "exampleTr": "Selam Tom, kısa bir sorum var: API çöktü mü?" },
    { "en": "Just a heads-up", "tr": "Bilgin olsun (önden haber)", "read": "cast ı [hedz]-ap", "type": "kalıp", "level": "B2", "example": "Just a heads-up: I'm off tomorrow.", "exampleTr": "Bilgin olsun: yarın izinliyim." },
    { "en": "FYI", "tr": "bilginize", "read": "ef {w}ay [ay]", "type": "kalıp", "level": "B1", "example": "FYI, the meeting has moved to three.", "exampleTr": "Bilginize, toplantı üçe alındı.", "note": "for your information" },
    { "en": "ASAP", "tr": "en kısa sürede", "read": "ey es ey [pii]", "type": "kalıp", "level": "B1", "example": "Please send it ASAP.", "exampleTr": "Lütfen en kısa sürede gönder.", "note": "as soon as possible; “ey-sap” diye de okunur" },
    { "en": "EOD", "tr": "gün sonu", "read": "ii ou [dii]", "type": "kalıp", "level": "B2", "example": "I'll have it ready by EOD.", "exampleTr": "Gün sonuna kadar hazır olur.", "note": "end of day" },
    { "en": "Any update on this?", "tr": "Bu konuda gelişme var mı?", "read": "e-ni [ap]-deyt on {d}is", "type": "kalıp", "level": "B1", "example": "Hi, any update on this?", "exampleTr": "Selam, bu konuda gelişme var mı?" },
    { "en": "Sorry for the delay", "tr": "Geç cevap için kusura bakma", "read": "[so]-ri fı {d}ı di-[ley]", "type": "kalıp", "level": "B1", "example": "Sorry for the delay, I was in meetings all day.", "exampleTr": "Geç cevap için kusura bakma, bütün gün toplantıdaydım." },
    { "en": "Thanks for flagging this", "tr": "Bunu bildirdiğin için teşekkürler", "read": "{t}{a}nks fı [fl{a}]-ging {d}is", "type": "kalıp", "level": "B2", "example": "Thanks for flagging this, I'll fix it.", "exampleTr": "Bildirdiğin için teşekkürler, düzelteceğim." },
    { "en": "Good catch", "tr": "İyi yakaladın", "read": "gud [k{a}ç]", "type": "kalıp", "level": "B1", "example": "Good catch! I missed that.", "exampleTr": "İyi yakaladın! Bunu kaçırmışım." },
    { "en": "Happy to help", "tr": "Yardımcı olmaktan memnuniyet duyarım", "read": "[h{a}]-pi tı [help]", "type": "kalıp", "level": "B1", "example": "Thanks! — Happy to help.", "exampleTr": "Teşekkürler! — Ne demek, memnuniyetle." },
    { "en": "Let me know if you have any questions", "tr": "Sorun olursa haber ver", "read": "let mi [nou] if yu h{a}v e-ni [k{w}es]-çınz", "type": "kalıp", "level": "B1", "example": "I've updated the docs. Let me know if you have any questions.", "exampleTr": "Dokümanı güncelledim. Sorun olursa haber ver." },
    { "en": "Please find attached", "tr": "Ekte bulabilirsiniz", "read": "pliiz faynd ı-[t{a}çt]", "type": "kalıp", "level": "B2", "example": "Please find attached the report.", "exampleTr": "Rapor ektedir." },
    { "en": "As discussed", "tr": "Konuştuğumuz gibi", "read": "ız di-[skast]", "type": "kalıp", "level": "B2", "example": "As discussed, here are the next steps.", "exampleTr": "Konuştuğumuz gibi, sonraki adımlar şunlar." },
    { "en": "Following up on", "tr": "… konusunu takip ederek", "read": "[fo]-lou-ing [ap] on", "type": "kalıp", "level": "B2", "example": "Following up on our call yesterday…", "exampleTr": "Dünkü görüşmemizin devamı olarak…" },
    { "en": "Could you take a look?", "tr": "Bir bakabilir misin?", "read": "kud yu teyk ı [luk]", "type": "kalıp", "level": "B1", "example": "I've opened a PR. Could you take a look?", "exampleTr": "PR açtım. Bir bakabilir misin?" },
    { "en": "No rush", "tr": "Acelesi yok", "read": "nou [raş]", "type": "kalıp", "level": "B1", "example": "No rush, next week is fine.", "exampleTr": "Acelesi yok, gelecek hafta da olur." },
    { "en": "Sounds good to me", "tr": "Bana uyar", "read": "saundz [gud] tı mi", "type": "kalıp", "level": "B1", "example": "Monday at ten? Sounds good to me.", "exampleTr": "Pazartesi onda mı? Bana uyar." },
    { "en": "Noted", "tr": "Not aldım", "read": "[nou]-tid", "type": "kalıp", "level": "B1", "example": "Noted, thanks!", "exampleTr": "Not aldım, teşekkürler!" },
    { "en": "Will do", "tr": "Yaparım, tamam", "read": "{w}il [duu]", "type": "kalıp", "level": "B1", "example": "Can you update the ticket? — Will do.", "exampleTr": "Kaydı güncelleyebilir misin? — Tamam, yaparım." },
    { "en": "On it", "tr": "Hemen ilgileniyorum", "read": "[on] it", "type": "kalıp", "level": "B1", "example": "The server is down! — On it.", "exampleTr": "Sunucu çöktü! — Hemen bakıyorum." },
    { "en": "out of office", "tr": "ofis dışında, izinde", "read": "aut ıv [o]-fis", "type": "kalıp", "level": "B1", "example": "I'm out of office until Monday.", "exampleTr": "Pazartesiye kadar izindeyim." },
    { "en": "ping", "tr": "kısa mesaj atmak, dürtmek", "read": "ping", "type": "fiil", "level": "B2", "example": "Ping me when you're free.", "exampleTr": "Müsait olunca bana yaz." },
    { "en": "loop in", "tr": "(konuşmaya) dahil etmek", "read": "luup [in]", "type": "fiil", "level": "B2", "example": "Let me loop in Sarah.", "exampleTr": "Sarah'yı da dahil edeyim." },
    { "en": "cc", "tr": "bilgi olarak eklemek (e-posta)", "read": "sii [sii]", "type": "fiil", "level": "B1", "example": "Please cc me on the email.", "exampleTr": "Lütfen e-postada beni bilgiye ekle." },
    { "en": "Thanks in advance", "tr": "Şimdiden teşekkürler", "read": "{t}{a}nks in ıd-[vaans]", "type": "kalıp", "level": "B1", "example": "Could you check this today? Thanks in advance!", "exampleTr": "Bugün bakabilir misin? Şimdiden teşekkürler!" }
  ]
}
