{
  "id": "core-health-symptoms",
  "group": "core",
  "title": "Sağlık 1: belirtiler ve hastalıklar",
  "level": "B1",
  "intro": "<p><b>Ağrı anlatmanın üç yolu:</b> <b>I've got a</b> headache / stomach ache (… ağrım var) · <b>My</b> back <b>hurts</b> / <b>aches</b> (… ağrıyor) · I've got a <b>sore</b> throat / sore eyes (boğazım / gözlerim ağrıyor). <b>British tuzak:</b> <b>be sick</b> = kusmak; hasta olmak = be ill.</p>",
  "words": [
    { "en": "symptom", "tr": "belirti", "read": "[simp]-tım", "type": "isim", "level": "B1", "example": "What are your symptoms?", "exampleTr": "Belirtileriniz neler?" },
    { "en": "ache", "tr": "ağrı; ağrımak (sürekli, hafif)", "read": "eyk", "type": "fiil", "level": "B1", "example": "My legs ache after running.", "exampleTr": "Koştuktan sonra bacaklarım ağrıyor.", "note": "ch = k" },
    { "en": "sore", "tr": "ağrılı, acıyan", "read": "soo", "type": "sıfat", "level": "B1", "example": "My eyes are sore from the screen.", "exampleTr": "Ekrandan gözlerim acıyor." },
    { "en": "dizzy", "tr": "başı dönen", "read": "[di]-zi", "type": "sıfat", "level": "B1", "example": "I feel dizzy when I stand up.", "exampleTr": "Ayağa kalkınca başım dönüyor." },
    { "en": "faint", "tr": "bayılmak", "read": "feynt", "type": "fiil", "level": "B2", "example": "She fainted in the heat.", "exampleTr": "Sıcakta bayıldı." },
    { "en": "sneeze", "tr": "hapşırmak", "read": "sniiz", "type": "fiil", "level": "B1", "example": "I can't stop sneezing.", "exampleTr": "Hapşırmayı durduramıyorum." },
    { "en": "breathe", "tr": "nefes almak", "read": "brii{d}", "type": "fiil", "level": "B1", "example": "Breathe in deeply.", "exampleTr": "Derin nefes alın.", "note": "isim: breath «bre{t}»" },
    { "en": "rash", "tr": "kızarıklık, döküntü", "read": "r{a}ş", "type": "isim", "level": "B1", "example": "I've got a rash on my arm.", "exampleTr": "Kolumda kızarıklık var." },
    { "en": "itchy", "tr": "kaşıntılı", "read": "[i]-çi", "type": "sıfat", "level": "B1", "example": "My skin is really itchy.", "exampleTr": "Cildim çok kaşınıyor." },
    { "en": "swollen", "tr": "şişmiş", "read": "[s{w}ou]-lın", "type": "sıfat", "level": "B1", "example": "My ankle is swollen.", "exampleTr": "Ayak bileğim şişmiş." },
    { "en": "bruise", "tr": "morluk; morarmak", "read": "bruuz", "type": "isim", "level": "B2", "example": "I've got a big bruise on my leg.", "exampleTr": "Bacağımda büyük bir morluk var." },
    { "en": "sprain", "tr": "burkmak", "read": "spreyn", "type": "fiil", "level": "B2", "example": "I sprained my ankle playing football.", "exampleTr": "Futbol oynarken ayak bileğimi burktum." },
    { "en": "ankle", "tr": "ayak bileği", "read": "[{a}n]-kıl", "type": "isim", "level": "B1", "example": "I twisted my ankle.", "exampleTr": "Ayak bileğimi burktum." },
    { "en": "wrist", "tr": "el bileği", "read": "rist", "type": "isim", "level": "B1", "example": "My wrist hurts from typing.", "exampleTr": "Yazmaktan bileğim ağrıyor.", "note": "w okunmaz" },
    { "en": "runny nose", "tr": "burun akması", "read": "[ra]-ni [nouz]", "type": "isim", "level": "B1", "example": "I've got a runny nose.", "exampleTr": "Burnum akıyor." },
    { "en": "blocked nose", "tr": "burun tıkanıklığı", "read": "blokt [nouz]", "type": "isim", "level": "B1", "example": "I can't sleep with a blocked nose.", "exampleTr": "Burnum tıkalıyken uyuyamıyorum.", "note": "British; Amerikan: stuffy nose" },
    { "en": "be sick", "tr": "kusmak (British)", "read": "bi [sik]", "type": "fiil", "level": "B1", "example": "I was sick twice last night.", "exampleTr": "Dün gece iki kez kustum.", "note": "British tuzak! Hasta olmak = be ill" },
    { "en": "diarrhoea", "tr": "ishal", "read": "day-ı-[riı]", "type": "isim", "level": "B2", "example": "I've had diarrhoea since yesterday.", "exampleTr": "Dünden beri ishalim.", "note": "British yazım; Amerikan: diarrhea" },
    { "en": "infection", "tr": "enfeksiyon", "read": "in-[fek]-şın", "type": "isim", "level": "B1", "example": "I think it's an ear infection.", "exampleTr": "Sanırım kulak enfeksiyonu." },
    { "en": "virus", "tr": "virüs", "read": "[vay]-rıs", "type": "isim", "level": "B1", "example": "It's just a virus. Rest and drink water.", "exampleTr": "Sadece bir virüs. Dinlen, su iç." },
    { "en": "migraine", "tr": "migren", "read": "[mii]-greyn", "type": "isim", "level": "B2", "example": "I get migraines when I'm stressed.", "exampleTr": "Stresliyken migrenim tutar.", "note": "British: “Mİİ-greyn”" },
    { "en": "asthma", "tr": "astım", "read": "[{a}s]-mı", "type": "isim", "level": "B2", "example": "My son has asthma.", "exampleTr": "Oğlumun astımı var.", "note": "th okunmaz" },
    { "en": "diabetes", "tr": "şeker hastalığı", "read": "day-ı-[bii]-tiiz", "type": "isim", "level": "B2", "example": "My father has diabetes.", "exampleTr": "Babamın şeker hastalığı var." },
    { "en": "hay fever", "tr": "saman nezlesi (polen alerjisi)", "read": "[hey] fii-vı", "type": "isim", "level": "B2", "example": "My hay fever is terrible in spring.", "exampleTr": "Baharda saman nezlem çok kötü.", "note": "British" },
    { "en": "food poisoning", "tr": "besin zehirlenmesi", "read": "fuud [poy]-zı-ning", "type": "isim", "level": "B2", "example": "I think I've got food poisoning.", "exampleTr": "Sanırım besin zehirlenmesi geçiriyorum." },
    { "en": "blood pressure", "tr": "tansiyon", "read": "[blad] pre-şı", "type": "isim", "level": "B1", "example": "Let me check your blood pressure.", "exampleTr": "Tansiyonunuza bakayım." },
    { "en": "heart attack", "tr": "kalp krizi", "read": "[haat] ı-t{a}k", "type": "isim", "level": "B1", "example": "He had a heart attack last year.", "exampleTr": "Geçen yıl kalp krizi geçirdi." },
    { "en": "anxiety", "tr": "kaygı, anksiyete", "read": "{a}n-[zay]-ı-ti", "type": "isim", "level": "B2", "example": "Exercise helps with anxiety.", "exampleTr": "Egzersiz kaygıya iyi gelir." },
    { "en": "back pain", "tr": "sırt ağrısı", "read": "[b{a}k] peyn", "type": "isim", "level": "B1", "example": "Sitting all day gives me back pain.", "exampleTr": "Bütün gün oturmak sırtımı ağrıtıyor." },
    { "en": "headache", "ref": "headache" },
    { "en": "cough", "ref": "cough" },
    { "en": "sore throat", "ref": "sore throat" },
