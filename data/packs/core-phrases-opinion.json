{
  "id": "core-phrases-opinion",
  "group": "core",
  "title": "Kalıplar 3: katılmak, itiraz, fikir",
  "level": "B1",
  "intro": "<p>İngilizler doğrudan “Hayır, yanılıyorsun” demez; itirazı yumuşatır. <b>So do I / Neither do I</b> yapısında yardımcı fiil önceki cümleye uyar: I like tea. — So <b>do</b> I. / I'm tired. — So <b>am</b> I.</p>",
  "words": [
    { "en": "I totally agree", "tr": "Kesinlikle katılıyorum", "read": "ay [tou]-tı-li ı-[grii]", "type": "kalıp", "level": "B1", "example": "I totally agree with you.", "exampleTr": "Sana kesinlikle katılıyorum." },
    { "en": "absolutely", "tr": "kesinlikle", "read": "{a}b-sı-[luut]-li", "type": "kalıp", "level": "B1", "example": "Can you come? — Absolutely!", "exampleTr": "Gelebilir misin? — Kesinlikle!" },
    { "en": "You're right", "tr": "Haklısın", "read": "yoo [rayt]", "type": "kalıp", "level": "A2", "example": "You're right, I made a mistake.", "exampleTr": "Haklısın, hata yaptım." },
    { "en": "That's true", "tr": "Bu doğru", "read": "{d}{a}ts [truu]", "type": "kalıp", "level": "A2", "example": "That's true, but it's expensive.", "exampleTr": "Doğru ama pahalı." },
    { "en": "I think so too", "tr": "Ben de öyle düşünüyorum", "read": "ay {t}ink [sou] tuu", "type": "kalıp", "level": "A2", "example": "It's a good idea. — I think so too.", "exampleTr": "İyi bir fikir. — Ben de öyle düşünüyorum." },
    { "en": "Me too", "tr": "Ben de", "read": "mii [tuu]", "type": "kalıp", "level": "A1", "example": "I'm hungry. — Me too.", "exampleTr": "Acıktım. — Ben de." },
    { "en": "Me neither", "tr": "Ben de (olumsuz)", "read": "mii [nay]-{d}ı", "type": "kalıp", "level": "A2", "example": "I don't like horror films. — Me neither.", "exampleTr": "Korku filmlerini sevmem. — Ben de." },
    { "en": "So do I", "tr": "Ben de (olumlu, resmi)", "read": "sou [duu] ay", "type": "kalıp", "level": "B1", "example": "I love London. — So do I.", "exampleTr": "Londra'yı çok seviyorum. — Ben de." },
    { "en": "Neither do I", "tr": "Ben de (olumsuz, resmi)", "read": "[nay]-{d}ı [duu] ay", "type": "kalıp", "level": "B1", "example": "I don't eat meat. — Neither do I.", "exampleTr": "Et yemem. — Ben de." },
    { "en": "I'm not so sure", "tr": "Pek emin değilim", "read": "aym not sou [şoo]", "type": "kalıp", "level": "B1", "example": "Is it a good idea? I'm not so sure.", "exampleTr": "İyi bir fikir mi? Pek emin değilim." },
    { "en": "I see your point, but…", "tr": "Ne demek istediğini anlıyorum ama…", "read": "ay sii yoo [poynt] bat", "type": "kalıp", "level": "B1", "example": "I see your point, but it's too risky.", "exampleTr": "Ne demek istediğini anlıyorum ama çok riskli." },
    { "en": "I don't think so", "tr": "Sanmıyorum", "read": "ay dount [{t}ink] sou", "type": "kalıp", "level": "A2", "example": "Will it rain? — I don't think so.", "exampleTr": "Yağmur yağar mı? — Sanmıyorum." },
    { "en": "Not really", "tr": "Pek değil", "read": "not [riı]-li", "type": "kalıp", "level": "A2", "example": "Do you like it? — Not really.", "exampleTr": "Beğendin mi? — Pek değil." },
    { "en": "It depends", "tr": "Duruma bağlı", "read": "it di-[pendz]", "type": "kalıp", "level": "B1", "example": "Will you come? — It depends on the weather.", "exampleTr": "Gelecek misin? — Havaya bağlı." },
    { "en": "In my view", "tr": "Bana göre", "read": "in may [vyuu]", "type": "kalıp", "level": "B2", "example": "In my view, we should wait.", "exampleTr": "Bana göre beklemeliyiz." },
    { "en": "If you ask me", "tr": "Bana sorarsan", "read": "if yu [aask] mi", "type": "kalıp", "level": "B1", "example": "If you ask me, it's too expensive.", "exampleTr": "Bana sorarsan çok pahalı." },
    { "en": "personally", "tr": "şahsen", "read": "[pöö]-sı-nı-li", "type": "kalıp", "level": "B1", "example": "Personally, I prefer working from home.", "exampleTr": "Şahsen evden çalışmayı tercih ederim." },
    { "en": "I'd rather", "tr": "… tercih ederim", "read": "ayd [raa]-{d}ı", "type": "kalıp", "level": "B1", "example": "I'd rather stay in tonight.", "exampleTr": "Bu akşam evde kalmayı tercih ederim.", "note": "I'd rather + yalın fiil" },
    { "en": "It's up to you", "tr": "Sana kalmış", "read": "its [ap] tı yu", "type": "kalıp", "level": "B1", "example": "Pizza or pasta? It's up to you.", "exampleTr": "Pizza mı makarna mı? Sana kalmış." },
    { "en": "Either is fine", "tr": "İkisi de olur", "read": "[ay]-{d}ı iz [fayn]", "type": "kalıp", "level": "B1", "example": "Tea or coffee? — Either is fine.", "exampleTr": "Çay mı kahve mi? — İkisi de olur." },
    { "en": "I don't mind", "tr": "Fark etmez, bence sorun yok", "read": "ay dount [maynd]", "type": "kalıp", "level": "A2", "example": "Where shall we eat? — I don't mind.", "exampleTr": "Nerede yiyelim? — Fark etmez.", "note": "British konuşmada çok yaygın" },
    { "en": "Why not?", "tr": "Neden olmasın?", "read": "{w}ay [not]", "type": "kalıp", "level": "A2", "example": "Shall we go to the cinema? — Why not?", "exampleTr": "Sinemaya gidelim mi? — Neden olmasın?" },
    { "en": "Good idea", "tr": "İyi fikir", "read": "gud ay-[diı]", "type": "kalıp", "level": "A1", "example": "Let's take a break. — Good idea.", "exampleTr": "Mola verelim. — İyi fikir." },
    { "en": "Sounds good", "tr": "Kulağa iyi geliyor", "read": "saundz [gud]", "type": "kalıp", "level": "A2", "example": "Lunch at one? — Sounds good.", "exampleTr": "Öğle yemeği birde mi? — Olur." },
    { "en": "I'm afraid I disagree", "tr": "Maalesef katılmıyorum", "read": "aym ı-[freyd] ay dis-ı-[grii]", "type": "kalıp", "level": "B2", "example": "I'm afraid I disagree with that.", "exampleTr": "Maalesef buna katılmıyorum.", "note": "Kibar itiraz" },
    { "en": "That's a good question", "tr": "Güzel soru", "read": "{d}{a}ts ı gud [k{w}es]-çın", "type": "kalıp", "level": "B1", "example": "That's a good question. Let me think.", "exampleTr": "Güzel soru. Bir düşüneyim." },
    { "en": "Fair point", "tr": "Haklı bir nokta", "read": "fee [poynt]", "type": "kalıp", "level": "B2", "example": "Fair point. I hadn't thought of that.", "exampleTr": "Haklısın. Bunu düşünmemiştim." },
    { "en": "I couldn't agree more", "tr": "Sonuna kadar katılıyorum", "read": "ay [ku]-dınt ı-grii [moo]", "type": "kalıp", "level": "B2", "example": "We need better tests. — I couldn't agree more.", "exampleTr": "Daha iyi testlere ihtiyacımız var. — Sonuna kadar katılıyorum." }
  ]
}
